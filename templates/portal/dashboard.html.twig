{#
    „Nástěnka hráče" — the player's home (item 06).

    Controller: src/Controller/Portal/DashboardController.php
    ONE soutěž is in focus, chosen with <twig:SoutezSwitcher> (?soutez={uuid}), and
    everything except „Moje soutěže" follows from it. „Moje soutěže" stays the full
    cross-soutěž overview on purpose.

    „Rozložení tipů" comes from the ListUserMatches batch (TipStatsProvider) — one
    resolution per page, NEVER a query per row (documented N+1 trap in CLAUDE.md).
#}
{% extends 'base.html.twig' %}

{% block title %}Nástěnka — {{ brand_name }}{% endblock %}

{% block body %}
<div class="bg-radial">
<div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">

{% if selected_competition is null %}

    {#
        Nikde nehraju. Pořadí je záměrné (B15): skoro každý, kdo sem dorazí prázdný,
        dostal PIN od organizátora — takže PIN je primární akce, „Procházet soutěže"
        druhá a „Vytvořit soutěž" až třetí a vizuálně menší. Zakládání vlastní soutěže
        je práce organizátora, ne první krok hráče.
    #}
    <header class="mb-6">
        <p class="eyebrow mb-3">Nástěnka</p>
        <h1 class="grad-headline text-3xl font-extrabold tracking-tight sm:text-4xl">
            <span>Ahoj, {{ app.user.nickname }}.</span>
        </h1>
        <p class="mt-4 max-w-2xl text-white/60">
            Zatím nehraješ v žádné soutěži. Nástěnka ukazuje jednu soutěž — tvoje pořadí,
            zápasy k tipnutí a žebříček.
        </p>
    </header>

    <div class="flex flex-col gap-4">
        {# 1. — PIN od organizátora #}
        {{ include('_partials/join_by_pin_form.html.twig') }}

        {# 2. — veřejné soutěže #}
        <div class="card-glass flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="font-bold text-white">Nemáš PIN?</p>
                <p class="mt-1 text-sm text-white/60">Projdi si veřejné soutěže a přidej se k některé.</p>
            </div>
            <a href="{{ path('competitions_list') }}" class="btn btn-ghost btn-sm shrink-0">
                <twig:ux:icon name="lucide:search" class="h-4 w-4" />
                Procházet soutěže
            </a>
        </div>

        {# 3. — až nakonec, a menší: založit si vlastní #}
        <p class="px-1 text-sm text-white/50">
            Chceš soutěž pro partu nebo firmu vést sám?
            <a href="{{ path('competition_create') }}" class="font-semibold text-accent-300 transition-colors hover:text-accent-200">Vytvoř si vlastní soutěž</a>.
        </p>
    </div>

{% else %}

    {% set competition_id = selected_competition.competitionId.toRfc4122 %}
    {# Every link on this page keeps the soutěž in focus and only changes its own knob. #}
    {% set base_params = {soutez: competition_id} %}
    {% if shows_all_competitions %}{% set base_params = base_params|merge({zapasy: 'vse'}) %}{% endif %}

    {# ───── Hero ───── #}
    <header class="mb-10 grid items-end gap-8 lg:grid-cols-[1fr_360px]">
        <div class="min-w-0">
            <p class="eyebrow mb-3">Nástěnka</p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
                <h1 class="grad-headline text-3xl font-extrabold tracking-tight sm:text-4xl">
                    <span>Ahoj, {{ app.user.nickname }}.</span>
                </h1>
                {# `dashboard` is reachable with no path parameter — that is what lets this
                   plain GET form scope the page by appending ?soutez=<id>. #}
                <twig:SoutezSwitcher
                    :competitions="my_competitions"
                    :currentId="competition_id"
                    route="dashboard"
                    param="soutez"
                    label="Zobrazená soutěž"
                    id="soutez-switcher-dashboard"
                    class="w-full min-w-0 sm:w-80"
                />
            </div>
            <p class="mt-4 max-w-2xl text-white/60">
                Na této obrazovce můžeš přepínat mezi jednotlivými soutěžemi, které hraješ,
                uvidíš zde zrychlené volby pro konkrétní soutěž.
            </p>
        </div>

        {# „Tvoje pozice" — jen když už mám v tabulce řádek #}
        {% if standing is not null %}
        <div class="flex flex-col gap-3">
            <div class="hero-rank">
                <p class="hero-rank-label">Tvoje pozice</p>
                <p class="hero-rank-pool">{{ selected_competition.competitionName }}</p>
                <p class="hero-rank-num">{{ standing.row.rank }}.<small>/ {{ player_count }}</small></p>
                <div class="hero-rank-meta">
                    <div>
                        <p class="lbl">Body</p>
                        <p class="val">{{ standing.row.totalPoints }}</p>
                    </div>
                    <div>
                        <p class="lbl">Změna</p>
                        <p class="val">
                            {%- if standing.row.deltaIsNew -%}
                                <span class="lb-delta-new">Nový</span>
                            {%- elseif standing.row.delta is not null -%}
                                <twig:Leaderboard:Delta :delta="standing.row.delta" :isNew="false" />
                            {%- else -%}
                                <span class="text-white/40">—</span>
                            {%- endif -%}
                        </p>
                    </div>
                    <div>
                        {% if standing.gapToTop5 is not null %}
                            <p class="lbl">Do top 5</p>
                            <p class="val text-accent-300">+{{ standing.gapToTop5 }}</p>
                        {% elseif standing.gapToTop3 is not null %}
                            <p class="lbl">Do top 3</p>
                            <p class="val text-accent-300">+{{ standing.gapToTop3 }}</p>
                        {% else %}
                            <p class="lbl">Úspěšnost</p>
                            <p class="val">{{ standing.row.evaluatedCount > 0 ? standing.row.accuracyPercent ~ ' %' : '—' }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Zrychlená volba pod tabulkou „Tvoje pozice" (tlačítko se šipkou). #}
            <a href="{{ path('leaderboard', {soutez: competition_id}) }}" class="btn btn-ghost btn-sm w-full justify-between">
                Zobrazit celou tabulku
                <twig:ux:icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
        </div>
        {% endif %}
    </header>

    {# ───── Poslední Tvoje tipy ───── #}
    <section class="mb-12">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
            <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Poslední Tvoje tipy</h2>
            {% if recent_guesses|length > 0 %}
                <a href="{{ path('leaderboard_member', {soutez: competition_id, userId: app.user.id.toRfc4122}) }}"
                   class="text-sm font-semibold text-accent-300 transition-colors hover:text-accent-200">
                    Historie
                    <twig:ux:icon name="lucide:arrow-right" class="inline h-4 w-4" />
                </a>
            {% endif %}
        </div>

        {% if recent_guesses|length == 0 %}
            <div class="card-glass p-8 text-center">
                <p class="text-sm text-white/60">Zatím nemáš žádný vyhodnocený tip. Jakmile se odehraje zápas, který jsi tipoval, objeví se tady i s body.</p>
            </div>
        {% else %}
            <div class="card-glass overflow-hidden p-0">
                {% for g in recent_guesses %}
                    {% set is_exact = g.myHomeScore == g.actualHomeScore and g.myAwayScore == g.actualAwayScore %}
                    <a href="{{ path('sport_match_detail', {id: g.sportMatchId.toRfc4122}) }}" class="result-row">
                        <span class="result-when">{{ g.kickoffAt|date('j. n.') }}</span>
                        <span class="result-match">
                            <twig:TeamFlag :team="g.homeTeam" size="24" />
                            <span class="truncate"><strong>{{ g.homeTeam.name }}</strong> – <strong>{{ g.awayTeam.name }}</strong></span>
                            <twig:TeamFlag :team="g.awayTeam" size="24" />
                        </span>
                        <span class="result-score">{{ g.actualHomeScore }} – {{ g.actualAwayScore }}</span>
                        <span class="result-tip {{ is_exact ? 'exact' : (g.totalPoints > 0 ? 'partial' : '') }}">{{ g.myHomeScore }} : {{ g.myAwayScore }}</span>
                        <span class="result-pts {{ g.totalPoints > 0 ? 'win' : 'miss' }}">{{ g.totalPoints > 0 ? '+' }}{{ g.totalPoints }} b</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

        {# Zrychlená volba: natipovat celou soutěž na jedné stránce. #}
        <div class="mt-4">
            <a href="{{ path('competition_my_tips_batch', {id: competition_id}) }}" class="btn btn-primary btn-sm">
                <twig:ux:icon name="lucide:target" class="h-4 w-4" />
                Tipovat zápasy v soutěži
            </a>
        </div>
    </section>

    {# ───── Moje soutěže — záměrně NEfiltrované přepínačem, je to přehled ───── #}
    <section class="mb-12">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
            <h2 class="flex items-center gap-2.5 text-xl font-bold tracking-tight text-white sm:text-2xl">
                Moje soutěže
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-semibold text-white/70">{{ my_competitions|length }}</span>
            </h2>
        </div>

        <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
            {% for g in my_competitions %}
                {% set is_selected = g.competitionId.toRfc4122 == competition_id %}
                <li>
                    {#
                        Celá karta vede do soutěže. Není to <a> okolo obsahu, ale
                        rozprostřený odkaz NAD ním (`.card-stretch`, poslední v DOM):
                        „Zobrazit na nástěnce" tak zůstává funkční a přitom nikdy
                        nevznikne interaktivní prvek vnořený v odkazu.
                    #}
                    <div class="card-glass card-clickable flex h-full flex-col justify-between p-5 sm:p-6{{ is_selected ? ' border-accent-500/40' }}">
                        <div>
                            <div class="mb-3 flex items-start justify-between gap-3">
                                <p class="eyebrow min-w-0 truncate">{{ g.matchSourceName }}</p>
                                <div class="flex shrink-0 flex-wrap items-center gap-1.5">
                                    {% if g.isOwner %}<twig:Badge label="Vlastník" variant="organizer" icon="crown" />{% endif %}
                                    {% if g.matchSourceIsCompleted %}<twig:Pill label="Ukončen" variant="done" />{% endif %}
                                </div>
                            </div>
                            <h3 class="text-lg font-bold leading-tight tracking-tight text-white">{{ g.competitionName }}</h3>
                        </div>

                        <div class="mt-5 flex items-center justify-between gap-3">
                            {% if is_selected %}
                                <span class="text-xs font-bold uppercase tracking-wider text-accent-300">Zobrazená</span>
                            {% else %}
                                <a href="{{ path('dashboard', {soutez: g.competitionId.toRfc4122}) }}" class="card-raise text-xs font-semibold text-white/50 transition-colors hover:text-white">Zobrazit na nástěnce</a>
                            {% endif %}
                            {# Nefunkční prvek — jen značka, že karta sama je proklik. #}
                            <span class="shrink-0 text-accent-300" aria-hidden="true">
                                <twig:ux:icon name="lucide:arrow-right" class="h-4 w-4" />
                            </span>
                        </div>

                        <a href="{{ path('competition_detail', {id: g.competitionId.toRfc4122}) }}"
                           class="card-stretch"
                           aria-label="Otevřít soutěž {{ g.competitionName }}"></a>
                    </div>
                </li>
            {% endfor %}
        </ul>

        {# „Všechny soutěže" patří pod seznam mých soutěží, ne do hlavičky sekce. #}
        <div class="mt-5 flex justify-center">
            <a href="{{ path('competitions_list') }}" class="btn btn-ghost btn-sm">
                Všechny soutěže
                <twig:ux:icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
        </div>
    </section>

    {# ───── Následující zápasy ───── #}
    {% set matches_visible = 5 %}
    <section class="mb-12" data-controller="reveal" data-reveal-visible-value="{{ matches_visible }}">
        <h2 class="mb-4 text-xl font-bold tracking-tight text-white sm:text-2xl">Následující zápasy</h2>

        <div class="mf-bar mb-4">
            <div class="lb-tabs !mb-0 flex-wrap">
                {% for key, label in filters %}
                    {% set is_active = key == active_filter %}
                    <a href="{{ path('dashboard', base_params|merge({filtr: key == 'vse' ? null : key})) }}"
                       class="lb-tab has-count{{ is_active ? ' active' }}">
                        {{ label }}
                        <span class="mf-count">{{ counts[key] }}</span>
                    </a>
                {% endfor %}
            </div>

            {# „SOUTĚŽ": the one control that widens the two match lists past the
               switcher's scope. A real GET form, so it works without JavaScript. #}
            {% if my_competitions|length > 1 %}
                <form method="get" action="{{ path('dashboard') }}" class="mf-scope">
                    <input type="hidden" name="soutez" value="{{ competition_id }}">
                    {% if active_filter != 'vse' %}<input type="hidden" name="filtr" value="{{ active_filter }}">{% endif %}
                    <label class="stat-lbl !mb-0" for="dashboard-zapasy">Soutěž</label>
                    <select id="dashboard-zapasy" name="zapasy" class="input">
                        <option value=""{{ shows_all_competitions ? '' : ' selected' }}>{{ selected_competition.competitionName }}</option>
                        <option value="vse"{{ shows_all_competitions ? ' selected' : '' }}>Všechny soutěže</option>
                    </select>
                    <button type="submit" class="btn btn-ghost btn-sm">Použít</button>
                </form>
            {% endif %}
        </div>

        {% if matches|length == 0 %}
            <div class="card-glass p-8 text-center">
                <p class="text-sm text-white/60">
                    {% if active_filter == 'vse' %}
                        V téhle soutěži zatím nejsou žádné zápasy. Jakmile se objeví, uvidíš je tady.
                    {% else %}
                        V tomhle filtru nic není — zkus <a href="{{ path('dashboard', base_params) }}" class="font-semibold text-accent-300 hover:text-accent-200">Vše</a>.
                    {% endif %}
                </p>
            </div>
        {% else %}
            <ul class="flex flex-col gap-3">
                {% for m in matches %}
                    <li data-reveal-target="item" class="{% if loop.index0 >= matches_visible %}hidden{% endif %}">
                        {{ include('portal/_dashboard_match_row.html.twig', {m: m, my_tips_by_match: my_tips_by_match}) }}
                    </li>
                {% endfor %}
            </ul>

            {% if matches|length > matches_visible %}
                <div class="mt-5 flex justify-center">
                    <button type="button"
                            data-reveal-target="toggle"
                            data-action="reveal#toggle"
                            data-reveal-more-label-value="Zobrazit další"
                            data-reveal-less-label-value="Zobrazit méně"
                            class="btn btn-ghost btn-sm">
                        Zobrazit další ({{ matches|length - matches_visible }})
                    </button>
                </div>
            {% endif %}
        {% endif %}
    </section>

    {# ───── Odehrané zápasy + žebříček ───── #}
    <section class="grid gap-8 lg:grid-cols-[1.5fr_1fr]">
        <div class="min-w-0">
            <h2 class="mb-4 text-xl font-bold tracking-tight text-white sm:text-2xl">Odehrané zápasy</h2>

            {% if played_matches|length == 0 %}
                <div class="card-glass p-8 text-center">
                    <p class="text-sm text-white/60">Ještě se neodehrál žádný zápas. Až první skončí, uvidíš tu výsledek i svůj tip.</p>
                </div>
            {% else %}
                <ul class="flex flex-col gap-3">
                    {% for m in played_matches %}
                        <li>{{ include('portal/_dashboard_match_row.html.twig', {m: m, my_tips_by_match: my_tips_by_match}) }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <aside class="min-w-0">
            <h2 class="mb-4 text-xl font-bold tracking-tight text-white sm:text-2xl">Žebříček</h2>

            {% if mini_leaderboard_rows|length == 0 %}
                <div class="card-glass p-8 text-center">
                    <p class="text-sm text-white/60">Žebříček se objeví, jakmile se vyhodnotí první tipy.</p>
                </div>
            {% else %}
                <div class="card-glass overflow-hidden p-0">
                    <div class="flex items-center justify-between gap-3 border-b border-white/[0.06] px-5 py-4">
                        <h3 class="text-base font-bold text-white">{{ selected_competition.competitionName }}</h3>
                        <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-semibold text-white/70">
                            Všichni · {{ player_count }}
                        </span>
                    </div>
                    {% for row in mini_leaderboard_rows %}
                        {{ include('portal/_dashboard_leaderboard_row.html.twig', {row: row, competition_id: competition_id}) }}
                    {% endfor %}
                    {% if mini_me_row is not null %}
                        <div class="border-t border-white/[0.06] py-1 text-center text-[11px] text-white/30">…</div>
                        {{ include('portal/_dashboard_leaderboard_row.html.twig', {row: mini_me_row, competition_id: competition_id}) }}
                    {% endif %}
                </div>

                <div class="mt-4 flex justify-end">
                    <a href="{{ path('leaderboard', {soutez: competition_id}) }}" class="text-sm font-semibold text-accent-300 transition-colors hover:text-accent-200">
                        Celý žebříček
                        <twig:ux:icon name="lucide:arrow-right" class="inline h-4 w-4" />
                    </a>
                </div>
            {% endif %}
        </aside>
    </section>

{% endif %}
</div>
</div>
{% endblock %}
