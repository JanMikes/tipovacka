{% extends 'base.html.twig' %}

{% block title %}{{ detail.name }} — {{ brand_name }}{% endblock %}

{% block body %}
{#
    B5: how many matches the viewer can still tip. A locked soutěž may legitimately
    keep rows open — matches added AFTER the lock moment (typically playoffs) run to
    their own kickoff, and the „Měnit tip" entitlement extends this viewer's window —
    so the header must not claim tipping is over while the list still offers „Tipovat".
#}
{% set open_match_rows = match_rows|filter(r => r.isOpen)|length %}
{# Produkt: „Zobrazit pouze 5 zápasů, pod tím tlačítko načíst všechny zápasy." #}
{% set matches_visible = 5 %}
<div class="bg-radial mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">

    {# ───────── Header: back link · eyebrow · name + stav · role · akce ───────── #}
    <header class="mb-8">
        <a href="{{ path('competitions_list') }}" class="mb-4 inline-flex items-center gap-1.5 text-sm text-white/50 transition-colors hover:text-white">
            <twig:ux:icon name="lucide:arrow-left" class="h-4 w-4" />
            Zpět na soutěže
        </a>

        <p class="eyebrow mb-2">
            <a href="{{ path('match_source_detail', {id: detail.matchSourceId.toRfc4122}) }}" class="transition-colors hover:text-accent-300">{{ detail.matchSourceName }}</a>
            {% if current_round %} · {{ current_round }}{% endif %}
        </p>

        <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3">
                    <h1 class="grad-headline text-3xl font-black tracking-tight sm:text-4xl">{{ detail.name }}</h1>
                    {% if is_over or detail.matchSourceIsCompleted %}
                        <twig:Pill label="Ukončeno" variant="done" icon="flag" />
                    {% elseif has_started %}
                        <twig:Pill label="Live" variant="live" dot />
                    {% endif %}
                    {% if tips_locked %}
                        <twig:Pill label="Tipy uzamčeny" variant="locked" icon="lock" />
                    {% elseif scheduled_lock_at %}
                        <twig:Pill label="Uzamčení {{ scheduled_lock_at|date('j. n. H:i') }}" variant="soon" icon="clock" />
                    {% endif %}
                </div>

                <div class="mt-3 flex flex-wrap items-center gap-2">
                    {% if is_owner %}
                        <twig:Badge label="Organizátor" variant="organizer" icon="crown" />
                    {% endif %}
                    {% if is_member %}
                        <twig:Badge label="Hráč" variant="competition" icon="user" />
                    {% endif %}
                    {% if scheduled_lock_at %}
                        {# B2: a manual lock moment that has not been reached yet. #}
                        <span class="inline-flex items-center gap-1.5 text-sm text-white/70">
                            <twig:ux:icon name="lucide:clock" class="h-4 w-4 text-accent-400" />
                            Uzamčení tipů naplánováno na {{ scheduled_lock_at|date('j. n. Y H:i') }}
                        </span>
                    {% elseif tips_locked and lock_moment %}
                        {# B5: the lock is a persistent state, not a one-shot flash — say
                           WHEN it took effect, right next to the „Tipy uzamčeny" pilulka. #}
                        <span class="inline-flex items-center gap-1.5 text-sm text-white/70">
                            <twig:ux:icon name="lucide:lock" class="h-4 w-4 text-white/50" />
                            Tipy uzamčeny {{ lock_moment|date('j. n. Y H:i') }}{% if open_match_rows > 0 %} — u některých zápasů je tipování stále otevřené{% endif %}
                        </span>
                    {% elseif lock_moment %}
                        <span class="inline-flex items-center gap-1.5 text-sm text-white/50">
                            <twig:ux:icon name="lucide:hourglass" class="h-4 w-4 text-white/40" />
                            Uzávěrka tipů: {{ lock_moment|date('j. n. Y H:i') }}
                        </span>
                    {% endif %}
                </div>
            </div>

            {# Akční lišta — každá položka má vlastní viditelnost, plný hráč nevidí nic. #}
            <div class="flex flex-wrap items-center gap-2">
                {% if is_granted('competition_edit', competition) %}
                    <a href="{{ path('competition_settings', {id: competition.id.toRfc4122}) }}" class="btn btn-ghost btn-sm">
                        <twig:ux:icon name="lucide:settings" class="h-4 w-4" />Nastavení
                    </a>
                {% endif %}
                {% if is_granted('competition_manage_join_mechanics', competition) %}
                    <a href="{{ path('competition_settings', {id: competition.id.toRfc4122}) }}#pozvanky" class="btn btn-ghost btn-sm">
                        <twig:ux:icon name="lucide:user-plus" class="h-4 w-4" />Pozvat
                    </a>
                {% endif %}
                {% if is_granted('competition_manage_members', competition) and not competition.isGlobal %}
                    <a href="{{ path('competition_manage_member_tips', {id: competition.id.toRfc4122}) }}" class="btn btn-ghost btn-sm">
                        <twig:ux:icon name="lucide:target" class="h-4 w-4" />Tipovat za členy
                    </a>
                {% endif %}
                {% if is_granted('competition_edit', competition) %}
                    {% if not tips_locked %}
                        {% set lock_form_id = 'lock-tips-' ~ competition.id.toRfc4122 %}
                        {# novalidate: flatpickr's calendar lives inside this form and its internal
                           hour/minute number inputs (step=5) would fail constraint validation and
                           silently block submitting. Nothing here needs browser validation — the
                           handler validates the moment. #}
                        <form method="post" id="{{ lock_form_id }}" novalidate action="{{ path('competition_lock_tips', {id: competition.id.toRfc4122}) }}"
                            data-controller="confirm"
                            data-confirm-variant-value="warning"
                            data-confirm-title-value="Uzamknout tipy"
                            data-confirm-message-value="Tipy všech členů se uzamknou, jako by soutěž právě odstartovala. Odemknout je půjde jen do výkopu prvního zápasu."
                            data-confirm-confirm-label-value="{{ scheduled_lock_at ? 'Uložit uzamčení' : 'Ano, uzamknout' }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('competition_lock_tips_' ~ competition.id.toRfc4122) }}">

                            {# B2 — the modal asks WHEN. The confirm controller moves this block into
                               the dialog; without JS the form posts „Ihned", i.e. the pre-B2 behaviour. #}
                            <div data-confirm-target="fields" hidden class="lock-when mt-5 space-y-2">
                                <label class="option-card flex cursor-pointer items-center gap-3">
                                    <input type="radio" name="lock_mode" value="now" {{ scheduled_lock_at ? '' : 'checked' }}
                                           class="h-4 w-4 shrink-0 border-white/20 bg-inset text-accent-500 focus:ring-accent-500">
                                    <span class="text-sm font-medium text-white">Ihned</span>
                                </label>
                                <label class="option-card flex cursor-pointer items-center gap-3">
                                    <input type="radio" name="lock_mode" value="at" {{ scheduled_lock_at ? 'checked' : '' }}
                                           class="h-4 w-4 shrink-0 border-white/20 bg-inset text-accent-500 focus:ring-accent-500">
                                    <span class="text-sm font-medium text-white">V určený čas</span>
                                </label>

                                <div class="lock-when-at field pt-1">
                                    <label class="field-label" for="{{ lock_form_id }}-at">Kdy se tipy uzamknou</label>
                                    <input type="text" name="lock_at" id="{{ lock_form_id }}-at" class="input"
                                           value="{{ scheduled_lock_at ? scheduled_lock_at|date('Y-m-d H:i') : '' }}"
                                           data-controller="datepicker"
                                           data-datepicker-mode-value="datetime"
                                           data-datepicker-inline-value="true"
                                           data-datepicker-min-date-value="{{ now|date('Y-m-d H:i') }}"
                                           {% if first_kickoff_at %}data-datepicker-max-date-value="{{ first_kickoff_at|date('Y-m-d H:i') }}"{% endif %}>
                                    <p class="text-xs text-white/40">
                                        Český čas.{% if first_kickoff_at %} Nejpozději před výkopem prvního zápasu ({{ first_kickoff_at|date('j. n. Y H:i') }}).{% endif %}
                                    </p>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-sm">
                                <twig:ux:icon name="lucide:lock" class="h-4 w-4" />{{ scheduled_lock_at ? 'Změnit uzamčení' : 'Uzamknout tipy' }}
                            </button>
                        </form>
                        {% if scheduled_lock_at and can_unlock_tips %}
                            <form method="post" action="{{ path('competition_unlock_tips', {id: competition.id.toRfc4122}) }}"
                                data-controller="confirm"
                                data-confirm-variant-value="warning"
                                data-confirm-title-value="Zrušit naplánované uzamčení"
                                data-confirm-message-value="Uzamčení naplánované na {{ scheduled_lock_at|date('j. n. Y H:i') }} se zruší. Tipy se pak uzamknou až se startem soutěže."
                                data-confirm-confirm-label-value="Ano, zrušit">
                                <input type="hidden" name="_token" value="{{ csrf_token('competition_unlock_tips_' ~ competition.id.toRfc4122) }}">
                                <button type="submit" class="btn btn-ghost btn-sm">
                                    <twig:ux:icon name="lucide:x" class="h-4 w-4" />Zrušit naplánování
                                </button>
                            </form>
                        {% endif %}
                    {% elseif can_unlock_tips %}
                        <form method="post" action="{{ path('competition_unlock_tips', {id: competition.id.toRfc4122}) }}"
                            data-controller="confirm"
                            data-confirm-variant-value="warning"
                            data-confirm-title-value="Odemknout tipy"
                            data-confirm-message-value="Ruční zámek se zruší a členové budou moct znovu tipovat až do startu soutěže."
                            data-confirm-confirm-label-value="Ano, odemknout">
                            <input type="hidden" name="_token" value="{{ csrf_token('competition_unlock_tips_' ~ competition.id.toRfc4122) }}">
                            <button type="submit" class="btn btn-ghost btn-sm">
                                <twig:ux:icon name="lucide:lock-open" class="h-4 w-4" />Odemknout tipy
                            </button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        {% if filter_teams is not empty %}
            <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-white/40">
                    <twig:ux:icon name="lucide:shield-half" class="h-4 w-4 text-accent-400" />Týmy soutěže
                </span>
                {% for team in filter_teams %}
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-inset py-1 pl-1 pr-2.5 text-xs text-white/80">
                        <twig:TeamFlag :team="team" size="20" />{{ team.name }}
                    </span>
                {% endfor %}
            </div>
        {% endif %}

    </header>

    {#
        Popis soutěže (item 19). Prázdný popis nevykreslí VŮBEC NIC — žádný box,
        žádný zástupný text. Uživatelský vstup: Twig ho escapuje a `|raw` tu nemá
        co dělat; řádky drží `whitespace-pre-line`, což je ještě bezpečnější než
        `|nl2br` (do HTML se nepřidá ani <br>).
    #}
    {% if detail.description %}
        <p class="mb-8 max-w-3xl whitespace-pre-line text-sm leading-relaxed text-white/60">{{ detail.description }}</p>
    {% endif %}

    {#
        ───────── Jeden sloupec (item 19) ─────────
        Item 08 dalo žebříček a vylepšení do postranního panelu; produkt to zrušil.
        Pořadí je rozhodnutí produktu (ROUND2 decision 6): [Pozvat kamaráda] →
        banner → Tabulka soutěže (zápasy) → Žebříček → Prémiové funkce.
    #}
    <div class="space-y-6">

        {# „Pozvat kamaráda" — míří do JEDINÉHO místa s pozvánkami (item 08). #}
        {% if is_granted('competition_manage_join_mechanics', competition) %}
            <div>
                <a href="{{ path('competition_settings', {id: competition.id.toRfc4122}) }}#pozvanky" class="btn btn-primary">
                    <twig:ux:icon name="lucide:user-plus" class="h-4 w-4" />
                    Pozvat kamaráda
                </a>
            </div>
        {% endif %}

        <div class="space-y-4">

            {#
                Batch-fill all my tips at once — the banner the product owner keeps above the list.
                B5: it may only invite when there IS something to tip. With everything locked the
                same spot states the fact instead, so the lock is visible without a flash message.
            #}
            {% if is_member and not detail.matchSourceIsCompleted and not is_over %}
                {% if open_match_rows > 0 %}
                    <a href="{{ path('competition_my_tips_batch', {id: competition.id.toRfc4122}) }}"
                       class="surface-accent group flex items-center gap-4 p-5 text-white">
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/15 ring-1 ring-white/20">
                            <twig:ux:icon name="lucide:zap" class="h-6 w-6" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="text-base font-semibold">Tipněte si všechny zápasy najednou</p>
                            <p class="mt-0.5 text-sm text-white/80">Vyplňte nebo upravte své tipy v jedné tabulce. Prázdná pole se přeskočí.</p>
                        </div>
                        <twig:ux:icon name="lucide:arrow-right" class="h-5 w-5 shrink-0 transition-transform group-hover:translate-x-1" />
                    </a>
                {% elseif tips_locked and match_rows|length > 0 %}
                    <div class="card-glass flex items-center gap-4 p-5">
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white/60">
                            <twig:ux:icon name="lucide:lock" class="h-6 w-6" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="text-base font-semibold text-white">Tipování uzavřeno</p>
                            <p class="mt-0.5 text-sm text-white/60">
                                {% if lock_moment %}Tipy se uzamkly {{ lock_moment|date('j. n. Y H:i') }}.{% endif %}
                                Měnit je už nejde — níže vidíte, co jste tipnul(a).
                            </p>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {#
                „Tabulka soutěže" — nadpis nad rozpisem (rozhodnutí produktu, ROUND2 batch 2).

                B25: server vykreslí VŠECHNY zápasy a tlačítko `hidden`; controller
                `reveal` teprve sbalí přebytek a tlačítko odkryje. S vypnutým
                JavaScriptem tedy není nedosažitelný ani jeden zápas — a zkrácení
                na 5 zůstává (produkt si vyžádal 5 + „načíst všechny").
            #}
            <section id="zapasy" class="space-y-3"
                     data-controller="reveal"
                     data-reveal-visible-value="{{ matches_visible }}"
                     data-reveal-more-label-value="Načíst všechny zápasy"
                     data-reveal-less-label-value="Zobrazit jen prvních {{ matches_visible }}">
                <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Tabulka soutěže</h2>

                {% if match_rows|length == 0 %}
                    <twig:EmptyState
                        illustration="matches"
                        title="Zatím žádné zápasy"
                        body="Jakmile se do zdroje zápasů přidají zápasy, objeví se tady."
                    />
                {% else %}
                    <ul class="flex flex-col gap-3">
                    {% for row in match_rows %}
                        {%- set m = row.match -%}
                        {%- set g = row.guess -%}
                        {%- set state = row.state -%}
                        {#
                            Stav řádku (odvozený v controlleru z CompetitionMatchProvider +
                            EffectiveTipDeadlineResolver): finished | locked | tipped | open.
                            Jedna pilulka na řádek, uzávěrka se propisuje do popisku.
                        #}
                        {% if state == 'finished' %}
                            {% set pill_variant = 'done' %}{% set pill_icon = 'check' %}{% set pill_label = 'Odehráno' %}{% set pill_dot = false %}
                        {% elseif m.state.value == 'postponed' %}
                            {% set pill_variant = 'warn' %}{% set pill_icon = 'triangle-alert' %}{% set pill_label = 'Odloženo' %}{% set pill_dot = false %}
                        {% elseif m.state.value == 'cancelled' %}
                            {% set pill_variant = 'locked' %}{% set pill_icon = 'x' %}{% set pill_label = 'Zrušeno' %}{% set pill_dot = false %}
                        {% elseif m.state.value == 'live' %}
                            {% set pill_variant = 'live' %}{% set pill_icon = null %}{% set pill_label = 'Právě hraje' %}{% set pill_dot = true %}
                        {% elseif state == 'locked' %}
                            {% set pill_variant = 'locked' %}{% set pill_icon = 'lock' %}{% set pill_label = g ? 'Uzamčeno' : 'Netipováno' %}{% set pill_dot = false %}
                        {% elseif state == 'tipped' %}
                            {% set pill_variant = 'tipped' %}{% set pill_icon = 'check' %}{% set pill_label = 'Tip odeslán' %}{% set pill_dot = false %}
                        {% else %}
                            {% set pill_variant = 'soon' %}{% set pill_icon = 'circle-alert' %}{% set pill_label = 'Chybí tip' %}{% set pill_dot = false %}
                        {% endif %}

                        {% set hit_class = null %}
                        {% if state == 'finished' and g and m.homeScore is not null %}
                            {% set my_outcome = g.homeScore > g.awayScore ? 1 : (g.homeScore < g.awayScore ? -1 : 0) %}
                            {% set real_outcome = m.homeScore > m.awayScore ? 1 : (m.homeScore < m.awayScore ? -1 : 0) %}
                            {% if g.homeScore == m.homeScore and g.awayScore == m.awayScore %}
                                {% set hit_class = 'exact' %}
                            {% elseif my_outcome == real_outcome %}
                                {% set hit_class = 'partial' %}
                            {% endif %}
                        {% endif %}

                        {# `cardUrl` = „Zápasy musí fungovat na proklik": celá karta vede na
                           zápas v této soutěži — týž cíl, na který vedou i odkazy uvnitř. #}
                        {% set match_url = path('competition_sport_match_guesses', {competitionId: competition.id.toRfc4122, sportMatchId: m.id.toRfc4122}) %}
                        <li data-reveal-target="item">
                        <twig:Match:MatchRow
                            :homeTeam="m.homeTeam"
                            :awayTeam="m.awayTeam"
                            :kickoffAt="m.kickoffAt"
                            :round="m.round"
                            :isPlayoff="m.isPlayoff"
                            :state="m.state.value == 'live' ? 'live' : (state == 'open' ? 'open' : state)"
                            :pillVariant="pill_variant"
                            :pillIcon="pill_icon"
                            :pillLabel="pill_label"
                            :pillDot="pill_dot"
                            :myHome="g ? g.homeScore : null"
                            :myAway="g ? g.awayScore : null"
                            :resultHome="state == 'finished' or m.state.value == 'live' ? m.homeScore : null"
                            :resultAway="state == 'finished' or m.state.value == 'live' ? m.awayScore : null"
                            :points="state == 'finished' ? row.points : null"
                            :hitClass="hit_class"
                            :tipPrompt="row.isOpen and is_member ? '+ Zadat tip' : null"
                            :tipMissingLabel="not row.isOpen and is_member and not g ? 'Netipováno' : null"
                            :detailUrl="match_url"
                            :detailLabel="row.isOpen and is_member ? 'Tipovat' : 'Detail zápasu'"
                            :tipUrl="row.isOpen and is_member ? match_url : null"
                            :tipStats="row.stats ? [row.stats] : []"
                            :footNote="row.isOpen ? 'Uzávěrka ' ~ row.deadline|date('j. n. Y H:i') : null"
                            :cardUrl="match_url"
                        />
                        </li>
                    {% endfor %}
                    </ul>

                    {% if match_rows|length > matches_visible %}
                        <div class="flex justify-center pt-2">
                            <button type="button" hidden
                                    data-reveal-target="toggle"
                                    data-action="reveal#toggle"
                                    class="btn btn-ghost btn-sm">
                                Načíst všechny zápasy ({{ match_rows|length - matches_visible }})
                            </button>
                        </div>
                    {% endif %}
                {% endif %}
            </section>
        </div>

        {# ───────── Žebříček („tabulka s hodnocením") ───────── #}
        <div class="space-y-6">

            {% if is_granted('leaderboard_view', competition) %}
                <section id="zebricek" class="card-glass overflow-hidden p-0">
                    <div class="flex items-center justify-between gap-3 border-b border-white/[0.06] px-5 py-4">
                        <h2 class="flex items-center gap-2 text-base font-bold text-white">
                            <twig:ux:icon name="lucide:trophy" class="h-5 w-5 text-accent-400" />
                            Žebříček
                        </h2>
                        <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-semibold tabular-nums text-white/70">
                            Všichni · {{ leaderboard_total }}
                        </span>
                    </div>

                    {% if leaderboard_rows|length == 0 %}
                        <p class="px-5 py-8 text-center text-sm text-white/50">Žebříček se objeví po prvních vyhodnocených tipech.</p>
                    {% else %}
                        <div>
                            {% for row in leaderboard_rows %}
                                {% set is_me = app.user and row.userId.equals(app.user.id) %}
                                <div class="lb-row{{ is_me ? ' me' }}">
                                    <span class="lb-pos{{ row.rank <= 3 ? ' rank-' ~ row.rank }}">{{ row.rank }}.</span>
                                    <a href="{{ path('leaderboard_member', {soutez: competition.id.toRfc4122, userId: row.userId.toRfc4122}) }}" class="flex min-w-0 items-center gap-3 hover:opacity-90">
                                        <twig:Avatar name="{{ row.fullName ?: row.nickname }}" size="30" rank="{{ row.rank <= 3 ? row.rank : null }}" />
                                        <span class="flex min-w-0 flex-col">
                                            <span class="truncate text-sm font-bold text-white">{{ row.fullName ?: row.nickname }}</span>
                                            <span class="truncate text-[11px] text-white/40">@{{ row.nickname }}</span>
                                        </span>
                                    </a>
                                    <span class="text-right"><span class="lb-pts">{{ row.totalPoints }}</span> <span class="text-[11px] font-light text-white/50">b</span></span>
                                    <span class="text-right">
                                        <twig:Leaderboard:Delta :delta="row.delta" :isNew="row.deltaIsNew" variant="chip" />
                                    </span>
                                </div>
                            {% endfor %}

                            {% if leaderboard_my_row is not null %}
                                <div class="border-t border-white/[0.06] py-1 text-center text-[11px] text-white/30">…</div>
                                <div class="lb-row me">
                                    <span class="lb-pos">{{ leaderboard_my_row.rank }}.</span>
                                    <a href="{{ path('leaderboard_member', {soutez: competition.id.toRfc4122, userId: leaderboard_my_row.userId.toRfc4122}) }}" class="flex min-w-0 items-center gap-3 hover:opacity-90">
                                        <twig:Avatar name="{{ leaderboard_my_row.fullName ?: leaderboard_my_row.nickname }}" size="30" />
                                        <span class="flex min-w-0 flex-col">
                                            <span class="truncate text-sm font-bold text-white">{{ leaderboard_my_row.fullName ?: leaderboard_my_row.nickname }}</span>
                                            <span class="truncate text-[11px] text-white/40">@{{ leaderboard_my_row.nickname }}</span>
                                        </span>
                                    </a>
                                    <span class="text-right"><span class="lb-pts">{{ leaderboard_my_row.totalPoints }}</span> <span class="text-[11px] font-light text-white/50">b</span></span>
                                    <span class="text-right">
                                        <twig:Leaderboard:Delta :delta="leaderboard_my_row.delta" :isNew="leaderboard_my_row.deltaIsNew" variant="chip" />
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="border-t border-white/[0.06] px-5 py-3 text-right">
                        <a href="{{ path('leaderboard', {soutez: competition.id.toRfc4122}) }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-300 transition-colors hover:text-accent-200">
                            Celý žebříček
                            <twig:ux:icon name="lucide:arrow-right" class="h-4 w-4" />
                        </a>
                    </div>
                </section>
            {% endif %}

        </div>

        {# ───────── Prémiové funkce / vylepšení ─────────
           Jeden monetizační model, nikdy oba (Premium XOR boosts) — komponenta si
           sama vybere podobu podle `monetization` a po skončení soutěže nic
           neprodává (B6). #}
        {% if is_granted('competition_view', competition) %}
            <div id="vylepseni">
                <twig:Boost:Panel :competition="competition" />
            </div>
        {% endif %}
    </div>

    {#
        První návštěva soutěže s vylepšeními: modal s cenami (item 19, uzavírá B10).
        Controller rozhoduje, komu se vůbec vykreslí — člen soutěže „boosts", která
        ještě neskončila, a jen dokud si ho neodklikl (stamp na členství).
    #}
    {% if show_boost_intro %}
        {{ include('portal/competition/_boost_intro_modal.html.twig') }}
    {% endif %}
</div>
