{% extends 'base.html.twig' %}

{% block title %}Moje tipy — {{ competition.name }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-12 pb-32 sm:px-6 lg:px-8">
    <twig:Breadcrumbs :items="[
        {label: 'Nástěnka', path: path('dashboard')},
        {label: competition.name, path: path('competition_detail', {id: competition.id.toRfc4122})},
        {label: 'Moje tipy'},
    ]" />

    <header class="mb-8">
        <span class="eyebrow">{{ competition.name }}</span>
        <h1 class="mt-2 text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">Moje tipy</h1>
        <p class="mt-3 text-sm leading-relaxed text-white/70">
            Zadejte nebo upravte všechny své tipy v jedné tabulce.
            Zobrazují se jen zápasy, u kterých je tipování ještě otevřené.
            Prázdná pole se přeskočí — nebo smažou stávající tip.
        </p>
    </header>

    {% if rows|length == 0 %}
        {# B5: an empty table after a lock must say WHY — „žádné zápasy" would be a lie. #}
        <div class="card flex flex-col items-center gap-3 p-10 text-center">
            {% if tips_locked %}
                <twig:ux:icon name="lucide:lock" class="h-8 w-8 text-white/40" />
                <p class="text-sm font-semibold text-white">Tipování uzavřeno</p>
                <p class="max-w-md text-sm text-white/60">
                    {% if lock_moment %}Tipy se uzamkly {{ lock_moment|date('j. n. Y H:i') }}.{% endif %}
                    Měnit je už nejde. Své tipy si prohlédnete u jednotlivých zápasů.
                </p>
                <a href="{{ path('competition_detail', {id: competition.id.toRfc4122}) }}" class="btn btn-ghost btn-sm mt-1">
                    <twig:ux:icon name="lucide:arrow-left" class="h-4 w-4" />Zpět na soutěž
                </a>
            {% else %}
                <twig:ux:icon name="lucide:calendar" class="h-8 w-8 text-white/40" />
                <p class="text-sm text-white/70">Žádné nadcházející zápasy k tipování.</p>
            {% endif %}
        </div>
    {% else %}
        <form method="post"
              action="{{ path('competition_my_tips_batch', {id: competition.id.toRfc4122}) }}">
            <input type="hidden" name="_token"
                   value="{{ csrf_token('my_tips_batch_' ~ competition.id.toRfc4122 ~ '_' ~ app.user.id.toRfc4122) }}">

            <section class="card overflow-hidden p-0">
                {# Stejný vnitřní okraj jako `.bt-row` na obou šířkách (20 / 24 px). #}
                <header class="border-b border-white/[0.06] px-5 py-5 sm:px-6">
                    <h2 class="text-lg font-bold text-white">Nadcházející zápasy</h2>
                    <p class="mt-1 text-xs text-white/50">
                        Vyplňte skóre u zápasů, které chcete tipnout. Prázdné nechte ty, které chcete přeskočit.
                    </p>
                    {% if features.scorerTips or features.overtimeTip %}
                        <p class="mt-2 flex items-center gap-1.5 text-xs text-accent-300">
                            <twig:ux:icon name="lucide:info" class="h-3.5 w-3.5 shrink-0" />
                            Střelce a prodloužení tipnete v detailu zápasu.
                        </p>
                    {% endif %}
                </header>

                <ul class="divide-y divide-white/[0.06]">
                    {% for row in rows %}
                        {# Jeden řádek = jeden zápas, ale dvě sazby: na mobilu je to
                           zrcadlená „fixture" (datum nad zápasem, týmy v jedné řadě,
                           políčko pod svým týmem), od 640 px vodorovný řádek. Celé to
                           řeší `.bt-*` v app.css — tady se nic nepřepíná. #}
                        <li class="bt-row">
                            <div class="bt-fixture">
                                <div class="bt-teams">
                                    <span class="bt-side">
                                        <twig:TeamFlag :team="row.match.homeTeam" size="40" />
                                        <span class="bt-name">{{ row.match.homeTeam.name }}</span>
                                    </span>
                                    <span class="bt-vs">vs</span>
                                    <span class="bt-side is-away">
                                        <span class="bt-name">{{ row.match.awayTeam.name }}</span>
                                        <twig:TeamFlag :team="row.match.awayTeam" size="40" />
                                    </span>
                                </div>
                                <p class="bt-when">
                                    <span>
                                        <twig:ux:icon name="lucide:calendar" class="h-3.5 w-3.5 shrink-0" />
                                        {{ row.match.kickoffAt|date('d. m. Y') }} · {{ row.match.kickoffAt|date('H:i') }}
                                    </span>
                                    {# Per-match effective deadline, shown only when it differs from the
                                       competition-level lock moment (late-added matches, manager overrides)
                                       AND from the výkop — „uzávěrka ve 20:00" pod „20:00" je jen druhý
                                       otisk téhož údaje, který na mobilu láme celý řádek. Stejné pravidlo
                                       jako v GuessSubmitForm. #}
                                    {% if row.deadline != row.match.kickoffAt and (lock_moment is null or row.deadline != lock_moment) %}
                                        <span>
                                            <twig:ux:icon name="lucide:hourglass" class="h-3.5 w-3.5 shrink-0" />
                                            Uzávěrka: {{ row.deadline|date('j. n. Y H:i') }}
                                        </span>
                                    {% endif %}
                                    {% if row.waiting %}
                                        <span class="is-wait">
                                            <twig:ux:icon name="lucide:clock" class="h-3.5 w-3.5 shrink-0" />
                                            Tipování otevřeme {{ row.opensAt|date('j. n. Y H:i') }}{% if row.openingNote %} — {{ row.openingNote }}{% endif %}
                                        </span>
                                    {% endif %}
                                </p>
                            </div>

                            {# Čekající zápas zůstává v seznamu, ale bez políček: žádné
                               `name="guesses[…]"` se neodešle, takže se nedá omylem
                               (ani schválně) uložit. Handler ho stejně odmítne. #}
                            {% if row.waiting %}
                                <div class="bt-wait">
                                    <twig:ux:icon name="lucide:clock" class="h-4 w-4 shrink-0" />
                                    Tipování ještě není otevřené
                                </div>
                            {% else %}
                            <div class="bt-controls">
                                <div class="bt-scores">
                                    {# inputmode: na mobilu vyskočí číselná klávesnice, ne QWERTY. #}
                                    <input type="number"
                                           inputmode="numeric"
                                           name="guesses[{{ row.match.id.toRfc4122 }}][homeScore]"
                                           min="0" max="99"
                                           value="{{ row.guess ? row.guess.homeScore : '' }}"
                                           class="score-input"
                                           aria-label="Domácí – {{ row.match.homeTeam.name }}">
                                    <span class="colon">:</span>
                                    <input type="number"
                                           inputmode="numeric"
                                           name="guesses[{{ row.match.id.toRfc4122 }}][awayScore]"
                                           min="0" max="99"
                                           value="{{ row.guess ? row.guess.awayScore : '' }}"
                                           class="score-input"
                                           aria-label="Hosté – {{ row.match.awayTeam.name }}">
                                </div>
                                {% if features.periodTips %}
                                    {% set guess_periods = row.guess and row.guess.periodScores is not null ? row.guess.periodScores.toArray : null %}
                                    <div class="bt-periods">
                                        {% for number in 1..sport.periodCount %}
                                            <span class="bt-period">
                                                {{ number }}. {{ sport.periodLabelSingular }}
                                                <input type="number"
                                                       inputmode="numeric"
                                                       name="guesses[{{ row.match.id.toRfc4122 }}][periods][{{ number }}][home]"
                                                       min="0" max="99"
                                                       value="{{ guess_periods and guess_periods[number - 1] is defined ? guess_periods[number - 1][0] : '' }}"
                                                       class="input px-1 text-center text-sm"
                                                       aria-label="{{ number }}. {{ sport.periodLabelSingular }} – domácí">
                                                <span class="text-white/30">:</span>
                                                <input type="number"
                                                       inputmode="numeric"
                                                       name="guesses[{{ row.match.id.toRfc4122 }}][periods][{{ number }}][away]"
                                                       min="0" max="99"
                                                       value="{{ guess_periods and guess_periods[number - 1] is defined ? guess_periods[number - 1][1] : '' }}"
                                                       class="input px-1 text-center text-sm"
                                                       aria-label="{{ number }}. {{ sport.periodLabelSingular }} – hosté">
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <div class="fixed inset-x-0 bottom-0 z-30 border-t border-white/10 bg-navy-900/90 backdrop-blur-xl">
                <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
                    <p class="hidden text-xs text-white/50 sm:block">
                        {{ rows|length }} {{ rows|length == 1 ? 'zápas' : (rows|length < 5 ? 'zápasy' : 'zápasů') }}
                    </p>
                    <button type="submit"
                            class="btn btn-primary w-full justify-center sm:w-auto">
                        <twig:ux:icon name="lucide:save" class="h-4 w-4" />
                        Uložit vše
                    </button>
                </div>
            </div>
        </form>
    {% endif %}

    {# Item 35 — „Měnit tip" is exactly what this page denies once tipy are uzamčené,
       so „Počkejte si na sestavy" is sold right here instead of on a shop card. The
       panel renders NOTHING unless the purchase would actually reopen something, so
       it is safe above both states of the table (prázdná i vyplněná). #}
    <twig:Boost:Panel :competition="competition" feature="tip_change" />
</div>
{% endblock %}
