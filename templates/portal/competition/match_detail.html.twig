{#
    THE match page (item 22) — one match, inside ONE soutěž.

    Controller: src/Controller/Portal/Competition/CompetitionMatchDetailController.php

    Every number here is scoped to the soutěž in the PATH; `<twig:SoutezSwitcher>`
    appends `?soutez=` and the controller 302s to that soutěž's own URL, so the
    control stays a plain GET form and the canonical URL stays path-scoped.

    The fixture and „Váš tip" are ONE card (item 22 §5): each team name is written
    exactly once, directly above the spinner it belongs to, and on a finished match
    the real result („Konečný výsledek") and the viewer's tip („Váš tip", with the
    points badge) are two labelled, differently-sized blocks — never confusable.

    „Rozložení tipů" is the shared <twig:Match:TipStats> fed by TipStatsProvider;
    „Pořadí za zápas" is the ONE list of other members' tips (item 22 folded the old
    „Jak tipovali ostatní" block into it), gated by TipVisibilityGate.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ sport_match.homeTeam.name }} vs {{ sport_match.awayTeam.name }} — {{ competition.name }} — {{ brand_name }}{% endblock %}

{% block body %}
{% set competition_id = competition.id.toRfc4122 %}
{% set match_id = sport_match.id.toRfc4122 %}
{% set can_score = is_granted('sport_match_set_score', sport_match) %}
{% set home_form = team_form ? team_form.for(sport_match.homeTeam.id) : null %}
{% set away_form = team_form ? team_form.for(sport_match.awayTeam.id) : null %}
{% set shows_score = sport_match.isFinished or (sport_match.isLive and sport_match.homeScore is not null) %}

<div class="bg-radial">
    <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">

        <twig:Breadcrumbs :items="[
            {label: 'Nástěnka', path: path('dashboard')},
            {label: competition.name, path: path('competition_detail', {id: competition_id})},
            {label: sport_match.homeTeam.name ~ ' vs ' ~ sport_match.awayTeam.name},
        ]" />

        {# ═════════ Scope: which soutěž are we tipping in ═════════ #}
        <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
            <div class="min-w-0">
                <p class="eyebrow">Zápas v soutěži</p>
                <p class="mt-1.5 text-sm text-white/55">
                    Tipujete za soutěž
                    <a href="{{ path('competition_detail', {id: competition_id}) }}"
                       class="font-bold text-accent-300 transition-colors hover:text-accent-200">{{ competition.name }}</a>.
                </p>
            </div>

            {# The switcher can only append `?soutez=`; the page redirects to that
               soutěž's own path-scoped URL, so routeParams pin THIS page as the
               form's action and the component needs no change. #}
            <twig:SoutezSwitcher
                :competitions="switcher_competitions"
                :currentId="competition_id"
                route="competition_sport_match_detail"
                :routeParams="{competitionId: competition_id, sportMatchId: match_id}"
                param="soutez"
                label="Zobrazená soutěž"
                id="soutez-switcher-match"
                class="w-full min-w-0 sm:w-80"
            />
        </div>

        {# ═════════ 1. The match AND your tip — ONE card ═════════ #}
        <section class="card-glass match-card p-5 text-white sm:p-6">
            <header class="mc-head">
                <div class="min-w-0">
                    <p class="mc-round">{{ sport_match.round ?: sport_match.matchSource.name }}</p>
                    <p class="mc-meta">
                        {%- if sport_match.round %}{{ sport_match.matchSource.name }} · {% endif -%}
                        {%- if sport_match.venue %}{{ sport_match.venue }} · {% endif -%}
                        {{ sport_match.kickoffAt|date('j. n. Y') }} · {{ sport_match.kickoffAt|date('H:i') }}
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2.5">
                    {% if sport_match.isFinished %}
                        <twig:Pill label="Ukončeno" variant="done" icon="check" />
                    {% elseif sport_match.isCancelled %}
                        <twig:Pill label="Zrušen" variant="locked" icon="circle-x" />
                    {% elseif sport_match.isPostponed %}
                        <twig:Pill label="Odložen" variant="warn" icon="triangle-alert" />
                    {% elseif sport_match.isLive %}
                        <twig:Pill label="Živě" variant="live" dot="true" />
                    {% else %}
                        <twig:Pill label="Naplánován" variant="soon" dot="true" />
                    {% endif %}

                    {% if can_score %}
                        <a href="{{ path('sport_match_set_score', {id: match_id}) }}" class="btn btn-ghost btn-sm shrink-0">
                            <twig:ux:icon name="lucide:pencil" class="h-4 w-4" />
                            {{ sport_match.isFinished ? 'Upravit výsledek' : 'Zapsat výsledek' }}
                        </a>
                    {% endif %}
                </div>
            </header>

            {# Coin + name (+ the team's record) per side, the score or „vs" between
               them. The name is written ONCE — the tip spinner below sits in the same
               grid track, so it reads as „this name's score". #}
            <div class="mc-fixture">
                <div class="mc-side">
                    <twig:TeamFlag :team="sport_match.homeTeam" size="48" />
                    <span class="mc-name" title="{{ sport_match.homeTeam.name }}">{{ sport_match.homeTeam.name }}</span>
                    {%- if sport_match.homeTeam.shortName or home_form -%}
                        <span class="mc-form">
                            {{- sport_match.homeTeam.shortName -}}
                            {%- if sport_match.homeTeam.shortName and home_form %} · {% endif -%}
                            {%- if home_form %}V{{ home_form.wins }} R{{ home_form.draws }} P{{ home_form.losses }}{% endif -%}
                        </span>
                    {%- endif -%}
                </div>

                <div class="mc-mid">
                    {% if shows_score %}
                        <span class="mc-score">
                            <span class="num">{{ sport_match.homeScore }}</span>
                            <span class="sep">:</span>
                            <span class="num">{{ sport_match.awayScore }}</span>
                        </span>
                        <span class="mc-score-lbl">{{ sport_match.isFinished ? 'Konečný výsledek' : 'Průběžný stav' }}</span>
                    {% else %}
                        <span class="mc-vs">vs</span>
                    {% endif %}
                </div>

                <div class="mc-side">
                    <twig:TeamFlag :team="sport_match.awayTeam" size="48" />
                    <span class="mc-name" title="{{ sport_match.awayTeam.name }}">{{ sport_match.awayTeam.name }}</span>
                    {%- if sport_match.awayTeam.shortName or away_form -%}
                        <span class="mc-form">
                            {{- sport_match.awayTeam.shortName -}}
                            {%- if sport_match.awayTeam.shortName and away_form %} · {% endif -%}
                            {%- if away_form %}V{{ away_form.wins }} R{{ away_form.draws }} P{{ away_form.losses }}{% endif -%}
                        </span>
                    {%- endif -%}
                </div>
            </div>

            {% if not sport_match.isCancelled and (sport_match.periodScores is not null or sport_match.hasOvertimeScore) %}
                <p class="mt-2 text-center text-xs text-white/45">
                    {%- if sport_match.periodScores is not null -%}
                        ({% for p in sport_match.periodScores.toArray %}{{ p[0] }}:{{ p[1] }}{% if not loop.last %}, {% endif %}{% endfor %})
                    {%- endif -%}
                    {%- if sport_match.hasOvertimeScore %} po prodl. {{ sport_match.overtimeHomeScore }}:{{ sport_match.overtimeAwayScore }}{% endif -%}
                </p>
            {% endif %}

            {# ── „Váš tip" — the same card, clearly the viewer's own row ── #}
            <div class="mc-tip">
                <div class="mc-tip-head">
                    <h2 class="eyebrow">Váš tip</h2>
                    {% if my_points is not null %}
                        <span class="my-tip-pts {{ my_points > 0 ? '' : 'is-zero' }}">{{ my_points > 0 ? '+' }}{{ my_points }}</span>
                    {% endif %}
                    {# B5: „Nevyplněno" is a call to action, so it may only appear while the
                       tip can still be filled. Past the deadline the same absence is a FACT
                       and the form itself says „Netipováno". #}
                    {% if not has_guess and not is_locked %}
                        <twig:Pill label="Nevyplněno" variant="danger" icon="circle-alert" />
                    {% endif %}
                </div>

                {# B19: the form renders bare inside this card. showTeamLabels=false keeps
                   the labels for screen readers but stops repeating the team names — the
                   fixture row above already names them, right over these inputs. #}
                <twig:Guess:GuessSubmitForm
                    id="guess-form-{{ competition_id }}"
                    :sportMatch="sport_match"
                    competitionId="{{ competition_id }}"
                    :bare="true"
                    :showTeamLabels="false"
                />
            </div>
        </section>

        {# B4: a soutěž of yours over THIS zdroj zápasů that does not include this match
           — say so and say why, instead of silently omitting it. Disjoint from the
           switcher by construction: it lists what INCLUDES the match, this what does not. #}
        {% if excluded_competitions_for_match_source|length > 0 %}
            <section class="card-glass mt-6 p-5">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-white">
                    <twig:ux:icon name="lucide:info" class="h-4 w-4 text-white/40" />
                    Proč tu nejsou všechny vaše soutěže
                </h3>
                <p class="mt-1 text-xs text-white/50">
                    {{ excluded_competitions_for_match_source|length > 1 ? 'Tyto soutěže tenhle zápas nezahrnují' : 'Tato soutěž tenhle zápas nezahrnuje' }} —
                    jste v {{ excluded_competitions_for_match_source|length > 1 ? 'nich' : 'ní' }} členem, ale tipuje se v {{ excluded_competitions_for_match_source|length > 1 ? 'nich' : 'ní' }} jen část zápasů zdroje.
                </p>

                <ul class="mt-3 space-y-2">
                    {% for c in excluded_competitions_for_match_source %}
                        <li class="rounded-xl border border-white/[0.06] bg-inset px-4 py-3">
                            <a href="{{ path('competition_detail', {id: c.id.toRfc4122}) }}" class="text-sm font-semibold text-white transition-colors hover:text-accent-300">
                                {{ c.name }}
                            </a>
                            <p class="mt-1 text-xs text-white/55">
                                {%- if c.reason == 'teams' -%}
                                    Soutěž zahrnuje jen zápasy vybraných týmů a ani jeden z nich v tomhle zápase nehraje.
                                {%- elseif c.reason == 'subset' -%}
                                    Soutěž zahrnuje jen ručně vybrané zápasy zdroje a tenhle mezi nimi není.
                                {%- elseif c.reason == 'playoff' -%}
                                    Soutěž se tipuje jen na základní část — zápasy playoff nezahrnuje.
                                {%- else -%}
                                    Tenhle zápas není v rozsahu zápasů této soutěže.
                                {%- endif -%}
                            </p>
                            {% if c.teams is not empty %}
                                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                                    <span class="text-[0.7rem] font-semibold uppercase tracking-wider text-white/40">Týmy soutěže</span>
                                    {% for team in c.teams %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.03] py-1 pl-1 pr-2.5 text-xs text-white/80">
                                            <twig:TeamFlag :team="team" size="20" />{{ team.name }}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {# ═════════ 2. + 3. Rozložení tipů (left) · Průběh zápasu (right) ═════════ #}
        {% set has_timeline = not sport_match.isCancelled and match_events|length > 0 %}
        {% if tip_stats or has_timeline %}
            <div class="mt-6 grid grid-cols-1 items-start gap-6 {{ tip_stats and has_timeline ? 'lg:grid-cols-2' : '' }}">
                {% if tip_stats %}
                    <twig:Match:TipStats
                        :stats="tip_stats"
                        :homeTeam="sport_match.homeTeam"
                        :awayTeam="sport_match.awayTeam"
                        :compact="false"
                    />
                {% endif %}

                {% if has_timeline %}
                    {% include 'portal/sport_match/_timeline.html.twig' with {sport_match: sport_match, match_events: match_events} only %}
                {% endif %}
            </div>
        {% endif %}

        {# ═════════ 4. Pořadí za zápas — the ONE list of other members' tips ═════════ #}
        {% if can_see_others_tips and match_ranking and match_ranking.rows|length > 0 %}
            {% set me_id = current_user_id.toRfc4122 %}
            {% set is_scored_match = sport_match.isFinished and sport_match.homeScore is not null and sport_match.awayScore is not null %}
            {% set real_outcome = is_scored_match ? (sport_match.homeScore > sport_match.awayScore ? 1 : (sport_match.homeScore < sport_match.awayScore ? -1 : 0)) : null %}
            <section class="card-glass mt-6 p-5 sm:p-6">
                <header class="dist-card-head">
                    <div class="min-w-0">
                        <h2 class="eyebrow">Pořadí za zápas</h2>
                        <p class="dist-card-total">
                            {{ match_ranking.isScored ? 'Nejvíc bodů z tohoto zápasu' : 'Jak tipovali ostatní' }}
                        </p>
                    </div>
                    <span class="shrink-0 text-xs font-medium tabular-nums text-white/50">
                        {{ match_ranking.rows|length }} {{ match_ranking.rows|length == 1 ? 'hráč' : (match_ranking.rows|length <= 4 ? 'hráči' : 'hráčů') }} s tipem
                    </span>
                </header>

                <div class="mt-4 overflow-x-auto">
                    <table class="lb-table">
                        {# Before the match is scored there are no ranks, no accuracy and no
                           points — three columns of dashes. Drop them rather than fake them. #}
                        <thead class="lb-thead">
                            <tr>
                                {% if match_ranking.isScored %}<th class="w-14">#</th>{% endif %}
                                <th>Hráč</th>
                                <th class="text-center">Tip</th>
                                {% if match_ranking.isScored %}
                                    <th class="text-center">Přesnost</th>
                                    <th class="text-right">Body</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in match_ranking.rows %}
                                {% set is_me = row.userId.toRfc4122 == me_id %}
                                {% set is_exact = is_scored_match and row.guessHome == sport_match.homeScore and row.guessAway == sport_match.awayScore %}
                                {% set guess_outcome = row.guessHome > row.guessAway ? 1 : (row.guessHome < row.guessAway ? -1 : 0) %}
                                {% set is_outcome = is_scored_match and not is_exact and guess_outcome == real_outcome %}
                                <tr class="lb-tr{{ is_me ? ' me' }}">
                                    {% if match_ranking.isScored %}
                                        <td>
                                            {% if row.rank is not null %}
                                                <span class="rank-mark">
                                                    <span aria-hidden="true" class="rank-dot{{ row.rank <= 3 ? ' rank-' ~ row.rank }}"></span>
                                                    <span class="lb-pos{{ row.rank <= 3 ? ' rank-' ~ row.rank }}">{{ row.rank }}.</span>
                                                </span>
                                            {% else %}
                                                <span class="text-white/25">–</span>
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                    <td>
                                        <div class="flex items-center gap-3">
                                            <twig:Avatar name="{{ row.fullName ?: row.nickname }}" size="32" rank="{{ row.rank is not null and row.rank <= 3 ? row.rank : null }}" />
                                            <span class="min-w-0">
                                                <span class="block truncate text-sm font-bold text-white">{{ row.nickname }}{% if is_me %} <span class="text-accent-300">· Ty</span>{% endif %}</span>
                                                {% if row.fullName %}<small class="block truncate text-[11px] font-light text-white/50">{{ row.fullName }}</small>{% endif %}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-sm font-bold tabular-nums text-white">{{ row.guessHome }}:{{ row.guessAway }}</span>
                                        {# The optional tip parts the old „Jak tipovali ostatní" block
                                           carried — periods, prodloužení, střelci. Folded in here so
                                           the page holds ONE list of these tips, not two. #}
                                        {% if row.periodScores is not null or row.overtimeHomeScore is not null or row.scorerNames|length > 0 %}
                                            <small class="mt-0.5 block text-[11px] font-light text-white/45">
                                                {%- if row.periodScores is not null -%}
                                                    ({% for p in row.periodScores %}{{ p[0] }}:{{ p[1] }}{% if not loop.last %}, {% endif %}{% endfor %})
                                                {%- endif -%}
                                                {%- if row.overtimeHomeScore is not null %} · prodl. {{ row.overtimeHomeScore }}:{{ row.overtimeAwayScore }}{% endif -%}
                                                {%- if row.scorerNames|length > 0 %} · {{ row.scorerNames|join(', ') }}{% endif -%}
                                            </small>
                                        {% endif %}
                                    </td>
                                    {% if match_ranking.isScored %}
                                        <td class="text-center">
                                            {% if is_exact %}
                                                <span class="acc-exact">Přesně</span>
                                            {% elseif is_outcome %}
                                                <span class="acc-outcome">Výsledek</span>
                                            {% else %}
                                                <span class="text-white/25">–</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-right">
                                            {% if row.totalPoints is null %}
                                                <span class="text-white/25">–</span>
                                            {% else %}
                                                <span class="lb-pts {{ row.totalPoints > 0 ? 'text-win' : 'text-white/40' }}">
                                                    {{- row.totalPoints > 0 ? '+' : '' }}{{ row.totalPoints -}}
                                                </span>
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% elseif not can_see_others_tips %}
            {# Locked twin of the distribution card, and since B27 literally the same shape:
               the gold CTA in the top-right is Boost:Panel in its `bare` shape — the one
               place boost pricing / affordability / B6 „soutěž už skončila" lives. The
               skeleton is decoration; the real tips are never rendered here. #}
            <section class="card-glass dist-card is-locked mt-6 p-5 sm:p-6">
                <header class="dist-card-head">
                    <div class="flex min-w-0 flex-wrap items-center gap-2.5">
                        {% if competition.monetization.value == 'premium' %}
                            <twig:Pill label="Prémium" variant="warn" icon="crown" />
                        {% elseif competition.monetization.value == 'boosts' %}
                            <twig:Pill label="Vylepšení" variant="warn" icon="sparkles" />
                        {% else %}
                            <twig:Pill label="Zamčeno" variant="locked" icon="lock" />
                        {% endif %}
                        <h2 class="eyebrow">Pořadí za zápas</h2>
                    </div>
                    <twig:Boost:Panel :competition="competition" feature="others" shape="bare" />
                </header>

                <div class="dist-veil">
                    <div aria-hidden="true" class="dist-skeleton space-y-4">
                        {% for width in [70, 55, 62, 48] %}
                            <div class="flex items-center gap-3">
                                <span class="dist-row-ghost is-short"></span>
                                <span class="dist-row-ghost" style="max-width: {{ width }}%"></span>
                            </div>
                        {% endfor %}
                    </div>

                    {# The card's own heading is „Pořadí za zápas", so unlike the
                       distribution card this overlay must NAME the booster it sells —
                       and it names it with BoostType::label(), never a retyped one.
                       The sentence is BoostType::description(); with nothing to sell
                       („none") the state constant speaks instead. #}
                    {% set others_boost = constant('App\\Enum\\BoostType::OthersTips') %}
                    <div class="dist-lock">
                        <span class="dist-lock-coin"><twig:ux:icon name="lucide:lock" class="h-5 w-5" /></span>
                        <p class="dist-lock-title">{{ others_boost.label }}</p>
                        <p class="dist-lock-note">
                            {{- competition.monetization.value == 'none'
                                ? constant('App\\Enum\\BoostType::LOCKED_AFTER_MATCH_NOTE')
                                : others_boost.description -}}
                        </p>
                    </div>
                </div>
            </section>
        {% endif %}

        {% if premium_enabled %}
            <div class="mt-6">
                <twig:PremiumTeaser />
            </div>
        {% endif %}

        {# ═════════ 5. Organizátor: uzávěrka a tipy členů ═════════ #}
        {% if deadline_form is not null %}
            <section class="card-glass mt-6 p-5 sm:p-6">
                <header class="mb-4 flex items-center gap-2.5">
                    <twig:ux:icon name="lucide:hourglass" class="h-5 w-5 text-accent-300" />
                    <h2 class="text-lg font-semibold text-white">Tipování tohoto zápasu</h2>
                </header>
                {{ form_start(deadline_form, {attr: {class: 'flex flex-wrap items-end gap-3'}}) }}
                    {# „Tipování otevřeno od" je jen pro adminy — pro ostatní pole
                       na formuláři vůbec není, takže se ho nedá poslat ani ručně. #}
                    {% if deadline_form.opensAt is defined %}
                        <div class="field min-w-[220px] flex-1">
                            {{ form_label(deadline_form.opensAt, null, {label_attr: {class: 'field-label mb-1.5'}}) }}
                            {{ form_widget(deadline_form.opensAt, {attr: {class: 'input'}}) }}
                            {% if deadline_form.opensAt.vars.help %}
                                <p class="mt-1 text-xs text-white/50">{{ deadline_form.opensAt.vars.help }}</p>
                            {% endif %}
                            {{ form_errors(deadline_form.opensAt) }}
                        </div>
                    {% endif %}
                    <div class="field min-w-[220px] flex-1">
                        {{ form_label(deadline_form.deadline, null, {label_attr: {class: 'field-label mb-1.5'}}) }}
                        {{ form_widget(deadline_form.deadline, {attr: {class: 'input'}}) }}
                        {% if deadline_form.deadline.vars.help %}
                            <p class="mt-1 text-xs text-white/50">{{ deadline_form.deadline.vars.help }}</p>
                        {% endif %}
                        {{ form_errors(deadline_form.deadline) }}
                    </div>
                    {% if deadline_form.openingNote is defined %}
                        <div class="field w-full">
                            {{ form_label(deadline_form.openingNote, null, {label_attr: {class: 'field-label mb-1.5'}}) }}
                            {{ form_widget(deadline_form.openingNote, {attr: {class: 'input'}}) }}
                            {% if deadline_form.openingNote.vars.help %}
                                <p class="mt-1 text-xs text-white/50">{{ deadline_form.openingNote.vars.help }}</p>
                            {% endif %}
                            {{ form_errors(deadline_form.openingNote) }}
                        </div>
                    {% endif %}
                    <button type="submit" class="btn btn-primary">
                        <twig:ux:icon name="lucide:save" class="h-4 w-4" />
                        Uložit
                    </button>
                {{ form_end(deadline_form) }}
            </section>
        {% endif %}

        {% if member_rows|length > 0 %}
            <section class="card-glass mt-6 overflow-hidden p-0">
                <header class="border-b border-white/[0.06] px-5 py-4 sm:px-6">
                    <div class="flex items-center gap-2.5">
                        <twig:ux:icon name="lucide:users" class="h-5 w-5 text-accent-300" />
                        <h2 class="text-lg font-semibold text-white">Tipy členů</h2>
                    </div>
                    <p class="mt-1 text-xs text-white/50">Jako vlastník můžete zadat tip za člena, který sám nemá přístup.</p>
                    {% if member_rows|filter(r => r.hasGuess and r.guess is null)|length > 0 %}
                        <p class="mt-1 flex items-center gap-1.5 text-xs text-white/50">
                            <twig:ux:icon name="lucide:eye-off" class="h-3.5 w-3.5 shrink-0" />
                            Cizí tipy nevidíte — víte jen, že je vyplněný. Uložením ho přepíšete.
                        </p>
                    {% endif %}
                </header>

                {# `now` comes from the app's clock (the controller), not Twig's `date()`,
                   which reads the system clock and therefore disagrees with it. #}
                {# Čekání na otevření zavírá tipy členů úplně stejně jako uzávěrka —
                   organizátor nemá výjimku (viz DOMAIN.md §Tip locking). #}
                {% set can_edit_member_tips = sport_match.isOpenForGuesses and not is_waiting and (effective_deadline > now) %}

                {# B5: disabled inputs alone do not explain themselves — name the state. #}
                {% if not can_edit_member_tips %}
                    <p class="flex items-center gap-1.5 border-b border-white/[0.06] px-5 py-3 text-xs text-white/60 sm:px-6">
                        <twig:ux:icon name="lucide:{{ is_waiting ? 'clock' : 'lock' }}" class="h-3.5 w-3.5 shrink-0" />
                        {% if is_waiting %}
                            Tipování otevřeme {{ opens_at|date('j. n. Y H:i') }}. Do té doby nejde zadat ani tipy členů.
                        {% elseif not sport_match.isOpenForGuesses %}
                            Tipování uzavřeno — zápas už začal nebo není aktivní. Tipy členů už zadat nejde.
                        {% else %}
                            Tipování uzavřeno — uzávěrka proběhla {{ effective_deadline|date('j. n. Y H:i') }}. Tipy členů už zadat nejde.
                        {% endif %}
                    </p>
                {% endif %}

                <ul class="divide-y divide-white/[0.06]">
                    {% for row in member_rows %}
                        <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-6">
                            <div class="flex min-w-[140px] items-center gap-2.5">
                                <twig:Avatar :name="row.user.nickname" size="32" />
                                <span class="font-medium text-white">{{ row.user.nickname }}</span>
                                {% if not row.user.isVerified %}
                                    <twig:Pill label="NEOVĚŘENÝ" variant="warn" />
                                {% endif %}
                                {% if row.hasGuess and row.guess is null %}
                                    <twig:Pill label="Vyplněno" variant="tipped" icon="check" />
                                {% elseif not row.hasGuess %}
                                    {# B5: „Nevyplněno" asks for action; once locked the absence is final.
                                       Item 34: kept `soon` here on purpose — `can_edit_member_tips` is built
                                       from the ORGANIZER's own effective_deadline (line 138 of the
                                       controller), not this row's member. Under Boosts monetization a
                                       manager who personally owns an active `tip_change` boost (allowed —
                                       PurchaseBoostHandler grants it to any active member, owner included)
                                       gets a later deadline than a member without one, so this can still
                                       read „Nevyplněno" after THAT member's own window has actually closed.
                                       The submit handler is safe (SubmitGuessOnBehalfHandler resolves the
                                       deadline against the TARGET member and rejects late writes), so this
                                       is a display-only bug, not a data one — flip to `danger` once the
                                       gate is computed per member (mirroring ManageMemberTipsController's
                                       deadlinesFor($competition, $candidateMatches, $selectedMember)). #}
                                    {% if can_edit_member_tips %}
                                        <twig:Pill label="Nevyplněno" variant="soon" icon="circle-alert" />
                                    {% else %}
                                        <twig:Pill label="Netipováno" variant="locked" icon="lock" />
                                    {% endif %}
                                {% endif %}
                            </div>

                            <form method="post"
                                  action="{{ path('competition_guess_on_behalf', {
                                      competitionId: competition_id,
                                      sportMatchId: match_id,
                                      memberId: row.user.id.toRfc4122,
                                  }) }}"
                                  class="flex items-center gap-2">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('guess_on_behalf_' ~ competition_id ~ '_' ~ match_id ~ '_' ~ row.user.id.toRfc4122) }}">
                                <input type="number" name="homeScore" min="0" max="99" required
                                       value="{{ row.guess ? row.guess.homeScore : '' }}"
                                       {% if not can_edit_member_tips %}disabled{% endif %}
                                       class="score-input w-14 disabled:cursor-not-allowed disabled:opacity-60"
                                       aria-label="Domácí">
                                <span class="text-white/30">:</span>
                                <input type="number" name="awayScore" min="0" max="99" required
                                       value="{{ row.guess ? row.guess.awayScore : '' }}"
                                       {% if not can_edit_member_tips %}disabled{% endif %}
                                       class="score-input w-14 disabled:cursor-not-allowed disabled:opacity-60"
                                       aria-label="Hosté">
                                <button type="submit"
                                        {% if not can_edit_member_tips %}disabled{% endif %}
                                        class="btn btn-primary btn-sm disabled:cursor-not-allowed disabled:opacity-40">
                                    {{ row.guess ? 'Upravit' : 'Uložit' }}
                                </button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
</div>
{% endblock %}
