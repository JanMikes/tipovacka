{% extends 'base.html.twig' %}

{% block title %}Zápasy soutěže — {{ competition.name }} — {{ brand_name }}{% endblock %}

{% block body %}
<div class="bg-radial mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">

    <twig:Breadcrumbs :items="[
        {label: 'Soutěže', path: path('competitions_list')},
        {label: competition.name, path: path('competition_detail', {id: competition.id.toRfc4122})},
        {label: 'Nastavení', path: path('competition_settings', {id: competition.id.toRfc4122})},
        {label: 'Zápasy soutěže'},
    ]" />

    <header class="mb-8">
        <p class="eyebrow mb-2">{{ competition.name }}</p>
        <h1 class="grad-headline text-3xl font-extrabold tracking-tight sm:text-4xl">Zápasy soutěže</h1>
        <p class="mt-3 max-w-2xl text-white/60">
            Co všechno se v soutěži tipuje. Zdroje můžete přidávat i odebírat kdykoli — zápasy, které
            přibudou později, dostanou vlastní uzávěrku tipů.
        </p>
    </header>

    <twig:Competition:ScopeEditor :competition="competition" />
</div>
{% endblock %}
