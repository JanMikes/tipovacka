{#
    Boost commerce surface. See src/Twig/Components/Boost/BoostPanel.php.
    props:
      competition  (Competition)
      feature      null = „Získej výhody" sidebar; 'others' = locked paywall for
                   concrete member tips (the distribution bar has its own surface:
                   <twig:Match:TipStats>, fed by TipStatsProvider)
      shape        'inline' (default) = the striped panel that IS the whole paywall
                   (tip matrix, guess page); 'bare' = the control only, in the gold
                   `.dist-unlock` vocabulary, for a caller that already owns the
                   card / skeleton / lock coin (B27, match detail)

    B6: once the competition is fully over (`this.competitionIsOver`) nothing can be
    bought here any more — the CTA is replaced by a one-line explanation. The command
    handler refuses the same purchase, so this is presentation, not the guard.
#}
{% set p = this.panel %}
{% if p is not null %}
    {% set mon = competition.monetization.value %}
    {% set back = app.request.pathinfo %}
    {% set is_over = this.competitionIsOver %}
    {% set offset_label = p.tipChangeOffsetMinutes % 60 == 0 ? (p.tipChangeOffsetMinutes // 60) ~ ' h' : p.tipChangeOffsetMinutes ~ ' min' %}
    {# The superset note names the included boost from BoostType::label() — one
       source for the name, so the confirm copy cannot drift (item 12). #}
    {% set dist_boost_label = constant('App\\Enum\\BoostType::TipDistribution').label %}
    {# ROUND2 decision 2 — these headlines/pitches are PANEL COPY ONLY: a marketing
       label above the product, never a rename. The canonical BoostType::label()
       names („Rozložení tipů ostatních" / „Konkrétní tipy kolegů" / „Měnit tip
       během turnaje", item 12) keep the confirm dialog, the prémium toggles,
       /cenik and the credit ledger. #}
    {% set boost_headlines = {
        tip_distribution: 'Jak tipují ostatní?',
        others_tips: 'Přesné tipy soupeřů',
        tip_change: 'Počkejte si na sestavy',
    } %}
    {% set boost_pitches = {
        tip_distribution: 'Odemkněte procentuální rozložení tipů 1 / X / 2 ostatních hráčů ve vaší soutěži. Konkrétní tipy zůstávají skryté.',
        others_tips: 'Chcete vědět, jak tipuje váš soupeř? Odemkněte si přesné tipy ostatních hráčů ve vaší soutěži.',
    } %}
    {# Owned benefits jump to the surface they unlocked (item 08). #}
    {% set jump_targets = {
        tip_distribution: {url: path('competition_detail', {id: competition.id.toRfc4122}) ~ '#zapasy', label: 'Zobrazit rozložení tipů'},
        others_tips: {url: path('leaderboard_matrix', {soutez: competition.id.toRfc4122}), label: 'Zobrazit tipy ostatních'},
        tip_change: {url: path('competition_my_tips_batch', {id: competition.id.toRfc4122}), label: 'Upravit své tipy'},
    } %}

    {% if feature is null %}
        {# ═════════ Management panel: „Získej výhody" ═════════ #}
        {% if mon == 'boosts' %}
            <section class="card-glass overflow-hidden p-0">
                <header class="border-b border-white/10 px-6 py-4">
                    <div class="flex items-center gap-2.5">
                        <twig:ux:icon name="lucide:sparkles" class="h-5 w-5 text-[#8ac3e8]" />
                        <h2 class="text-lg font-semibold text-white">Získej výhody</h2>
                    </div>
                    <p class="mt-2 text-[12px] leading-snug text-white/55">
                        Za kredity si můžete odemknout výhody, které vám pomohou získat lepší přehled a větší kontrolu při tipování v soutěži.
                    </p>
                </header>
                <div class="divide-y divide-white/[0.06]">
                    {% for type in this.boostTypes %}
                        {% set owned = (type.value == 'tip_distribution' and p.hasDistribution)
                            or (type.value == 'others_tips' and p.hasOthersTips)
                            or (type.value == 'tip_change' and p.hasTipChange) %}
                        {% set superseded = type.value == 'tip_distribution' and p.hasOthersTips and not p.hasExplicitDistribution %}
                        {# Manager/admin already sees tips for free → never sell them a visibility boost. #}
                        {% set autoEntitled = (type.value == 'tip_distribution' and p.autoEntitledToDistribution)
                            or (type.value == 'others_tips' and p.autoEntitledToOthersTips) %}
                        {% if not autoEntitled %}
                        <div class="px-6 py-4">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-white">{{ boost_headlines[type.value] }}</p>
                                    <p class="mt-0.5 text-[12px] leading-snug text-white/55">
                                        {% if type.value == 'tip_change' %}
                                            {# The offset is prémium-configurable, so the promise is rendered, never hard-coded. #}
                                            Chcete si počkat na soupisky? Odemkněte si možnost upravit své tipy až {{ offset_label }} před začátkem zápasu.
                                        {% else %}
                                            {{ boost_pitches[type.value] }}
                                        {% endif %}
                                    </p>
                                </div>
                                {% if owned %}
                                    <span class="pill pill-success shrink-0">
                                        <twig:ux:icon name="lucide:check" class="h-3 w-3" />
                                        {{ superseded ? 'V balíčku' : 'Aktivní' }}
                                    </span>
                                {% elseif not is_over %}
                                    <span class="shrink-0 text-sm font-black tabular-nums text-[#8ac3e8]">{{ type.price }} kr.</span>
                                {% endif %}
                            </div>
                            {% if owned %}
                                {# Bought ⇒ jump straight to the surface it unlocked. #}
                                {% set jump = jump_targets[type.value] %}
                                <div class="mt-3">
                                    <a href="{{ jump.url }}" class="btn btn-ghost btn-sm w-full justify-between">
                                        {{ jump.label }}
                                        <twig:ux:icon name="lucide:arrow-right" class="h-4 w-4" />
                                    </a>
                                </div>
                            {% elseif is_over %}
                                <p class="mt-3 text-[12px] leading-snug text-white/45">
                                    Soutěž už skončila — vylepšení už nemá co odemknout.
                                </p>
                            {% else %}
                                <div class="mt-3">
                                    {% if p.canAfford(type) %}
                                        <form method="post" action="{{ path('competition_boost_purchase', {id: competition.id.toRfc4122}) }}"
                                            data-controller="confirm"
                                            data-confirm-variant-value="warning"
                                            data-confirm-title-value="Koupit „{{ type.label }}“"
                                            data-confirm-message-value="Za {{ type.price }} kr. z vašeho zůstatku ({{ p.balance }} kr.). {{ type.value == 'others_tips' ? 'Obsahuje i ' ~ dist_boost_label ~ '.' }}"
                                            data-confirm-confirm-label-value="Koupit za {{ type.price }} kr.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('boost_purchase_' ~ competition.id.toRfc4122) }}">
                                            <input type="hidden" name="type" value="{{ type.value }}">
                                            <input type="hidden" name="_redirect" value="{{ back }}">
                                            <button type="submit" class="btn btn-primary btn-sm w-full">
                                                <twig:ux:icon name="lucide:unlock" class="h-4 w-4" />
                                                Koupit za {{ type.price }} kr.
                                            </button>
                                        </form>
                                    {% else %}
                                        <a href="{{ path('credits') }}" class="btn btn-ghost btn-sm w-full">
                                            <twig:ux:icon name="lucide:wallet" class="h-4 w-4" />
                                            Dokoupit kredity
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="flex items-center justify-between border-t border-white/10 px-6 py-3 text-xs">
                    <span class="text-white/50">Váš zůstatek</span>
                    <span class="font-bold tabular-nums text-white">{{ p.balance }} kr.</span>
                </div>
            </section>
        {% elseif mon == 'premium' %}
            <section class="relative overflow-hidden rounded-2xl border border-[#f5cd54]/30 bg-gradient-to-br from-[#f5cd54]/[0.12] to-transparent p-5">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5cd54]/40 bg-[#f5cd54]/15 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-[#f5cd54]">
                    <twig:ux:icon name="lucide:crown" class="h-3.5 w-3.5" />
                    Prémium
                </span>
                <h3 class="mt-3 text-base font-bold text-white">Vylepšení máte v ceně</h3>
                <p class="mt-1.5 text-sm text-white/60">Organizátor platí za celou partičku — funkce zapíná pro všechny.</p>
            </section>
        {% endif %}
    {% else %}
        {# ═════════ Locked paywall („Konkrétní tipy kolegů") ═════════ #}
        {% set type = this.featureType %}
        {% if shape == 'bare' %}
            {# B27 — BARE shape: the control only, in the same gold vocabulary the
               „Rozložení tipů" paywall uses (`.dist-unlock`), so a caller that
               already draws the card + blurred skeleton + lock coin gets ONE
               treatment instead of a second, differently-styled panel inside its
               own. Pricing, affordability and B6 „soutěž už skončila" stay here —
               that is the whole reason the caller composes this component. #}
            {% if mon == 'boosts' and is_over %}
                <span class="dist-unlock is-static">Soutěž už skončila</span>
            {% elseif mon == 'boosts' and p.canAfford(type) %}
                <form method="post" action="{{ path('competition_boost_purchase', {id: competition.id.toRfc4122}) }}"
                    class="dist-buy"
                    data-controller="confirm"
                    data-confirm-variant-value="warning"
                    data-confirm-title-value="Odemknout „{{ type.label }}“"
                    data-confirm-message-value="Za {{ type.price }} kr. z vašeho zůstatku ({{ p.balance }} kr.). {{ type.value == 'others_tips' ? 'Obsahuje i ' ~ dist_boost_label ~ '.' }}"
                    data-confirm-confirm-label-value="Koupit za {{ type.price }} kr.">
                    <input type="hidden" name="_token" value="{{ csrf_token('boost_purchase_' ~ competition.id.toRfc4122) }}">
                    <input type="hidden" name="type" value="{{ type.value }}">
                    <input type="hidden" name="_redirect" value="{{ back }}">
                    <button type="submit" class="dist-unlock card-raise group">
                        Odemknout za {{ type.price }} kr.
                        <twig:ux:icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                    </button>
                    {# The whole card is the same purchase. Rendered hidden; the
                       `confirm` controller unhides it on connect, so a page whose
                       JavaScript never ran keeps only the explicit button above. #}
                    <button type="submit" data-confirm-target="stretch" class="card-stretch" hidden>
                        Odemknout „{{ type.label }}“ za {{ type.price }} kr.
                    </button>
                </form>
            {% elseif mon == 'boosts' %}
                <a href="{{ path('credits') }}" class="dist-unlock">
                    <twig:ux:icon name="lucide:wallet" class="h-3.5 w-3.5" />
                    Chybí kredity ({{ p.balance }}/{{ type.price }} kr.)
                </a>
            {% elseif mon == 'premium' %}
                <span class="dist-unlock is-static">Zapíná organizátor</span>
            {% endif %}
            {# mon == 'none' → nothing to sell; the caller's note says it opens
               once the zápas is played. #}
        {% elseif mon == 'boosts' %}
            <section class="relative overflow-hidden rounded-2xl border border-[#8ac3e8]/25 p-5"
                style="background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.03) 0 10px, transparent 10px 20px);">
                <div class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#8ac3e8]/15 text-[#8ac3e8]">
                        <twig:ux:icon name="lucide:lock" class="h-4 w-4" />
                    </span>
                    <div class="min-w-0">
                        <h3 class="text-sm font-bold text-white">Odemkněte konkrétní tipy kolegů</h3>
                        <p class="mt-1 text-[12px] leading-snug text-white/55">{{ type.description }}</p>
                    </div>
                </div>
                <div class="mt-4">
                    {% if is_over %}
                        <p class="text-[12px] leading-snug text-white/50">Soutěž už skončila — vylepšení už nemá co odemknout.</p>
                    {% elseif p.canAfford(type) %}
                        <form method="post" action="{{ path('competition_boost_purchase', {id: competition.id.toRfc4122}) }}"
                            data-controller="confirm"
                            data-confirm-variant-value="warning"
                            data-confirm-title-value="Odemknout „{{ type.label }}“"
                            data-confirm-message-value="Za {{ type.price }} kr. z vašeho zůstatku ({{ p.balance }} kr.). {{ type.value == 'others_tips' ? 'Obsahuje i ' ~ dist_boost_label ~ '.' }}"
                            data-confirm-confirm-label-value="Koupit za {{ type.price }} kr.">
                            <input type="hidden" name="_token" value="{{ csrf_token('boost_purchase_' ~ competition.id.toRfc4122) }}">
                            <input type="hidden" name="type" value="{{ type.value }}">
                            <input type="hidden" name="_redirect" value="{{ back }}">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <twig:ux:icon name="lucide:unlock" class="h-4 w-4" />
                                Odemknout za {{ type.price }} kr.
                            </button>
                        </form>
                    {% else %}
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="text-[12px] text-white/50">Chybí kredity ({{ p.balance }} / {{ type.price }} kr.)</span>
                            <a href="{{ path('credits') }}" class="btn btn-ghost btn-sm">
                                <twig:ux:icon name="lucide:wallet" class="h-4 w-4" />
                                Dokoupit kredity
                            </a>
                        </div>
                    {% endif %}
                </div>
            </section>
        {% elseif mon == 'premium' %}
            <section class="rounded-2xl border border-[#f5cd54]/25 bg-[#f5cd54]/[0.06] p-4">
                <p class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#f5cd54]">
                    <twig:ux:icon name="lucide:crown" class="h-4 w-4" />
                    Prémium
                </p>
                <p class="mt-1 text-[12px] text-white/55">Tuto funkci zapíná organizátor soutěže pro všechny.</p>
            </section>
        {% else %}
            <section class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <p class="inline-flex items-center gap-1.5 text-sm font-medium text-white/60">
                    <twig:ux:icon name="lucide:lock" class="h-4 w-4 text-white/40" />
                    Tipy ostatních se zobrazí po odehrání zápasu.
                </p>
            </section>
        {% endif %}
    {% endif %}
{% endif %}
