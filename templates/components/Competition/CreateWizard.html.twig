{#
    Competition:CreateWizard (S08) — the single guided „Vytvořit soutěž" flow.

    4 steps driven by LiveProps + LiveActions (next/back/submit); the dot stepper
    reflects `step`. See src/Twig/Components/Competition/CreateWizard.php for the
    judgment calls (LiveProp-driven checklist, writable-array rule state, WYSIWYG
    PIN/link). Glossary: soutěž = Competition, zdroj zápasů = MatchSource.
#}
{% set step_labels = {1: 'Základy', 2: 'Pravidla', 3: 'Pozvánky', 4: 'Podpora'} %}
{# W1: the per-rule copy is ONE shared map (RulePresetProvider::RULE_COPY),
   also rendered by Scoring:RuleFields — the wizard and the post-creation rules
   screen must never name a rule differently. #}
{% set rule_copy = this.ruleCopy %}
{% set section_headings = {
    base: 'Základní bodování',
    periods: 'Tipovat také ' ~ this.ruleSport.periodLabelPlural ~ ' zápasu?',
    scorers: 'Chcete tipovat také střelce utkání?',
    overtime: 'Tipovat celkové skóre po prodloužení či penaltách?',
} %}

<div {{ attributes }} class="mx-auto w-full max-w-3xl">
    <div class="modal-panel !p-0">
        {# ---- Stepper ---- #}
        <div class="border-b border-white/10 px-6 py-6 sm:px-8">
            <div class="stepper">
                {% for s in this.stepSequence %}
                    {% set position = loop.index %}
                    <div class="step-item">
                        <div class="step-num {{ step == s ? 'active' : (this.stepPosition > position ? 'done' : '') }}">
                            {% if this.stepPosition > position %}
                                <twig:ux:icon name="lucide:check" class="h-4 w-4" />
                            {% else %}
                                {{ position }}
                            {% endif %}
                        </div>
                        <span class="step-label {{ this.stepPosition >= position ? 'is-current' : '' }}">{{ step_labels[s] }}</span>
                    </div>
                    {% if not loop.last %}
                        <div class="step-bar {{ this.stepPosition > position ? 'done' : '' }}"></div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="px-6 py-7 sm:px-8">
            {% if errorMessage %}
                <div class="mb-5 flex items-start gap-2 rounded-xl border border-loss/40 bg-loss/10 px-4 py-3 text-sm text-white">
                    <twig:ux:icon name="lucide:circle-alert" class="mt-0.5 h-4 w-4 shrink-0 text-loss" />
                    <span>{{ errorMessage }}</span>
                </div>
            {% endif %}

            {# ================= KROK 1 — Základy ================= #}
            {% if step == 1 %}
                <div class="mb-6">
                    <span class="eyebrow">Krok {{ this.stepPosition }} ze {{ this.stepCount }}</span>
                    <h2 class="mt-1 text-2xl font-black tracking-tight text-white">Vytvořit novou soutěž</h2>
                    <p class="mt-1 text-sm text-white/60">{{ isGlobalKind ? 'Veřejná soutěž nad kurátorovaným zdrojem — přidat se může kdokoli za vstupné.' : 'Nastavte základy. Hráče pozvete v dalším kroku.' }}</p>
                </div>

                <div class="space-y-5">
                    {% if this.isAdmin %}
                        {# Admin-only: pick private vs global. Actions re-check ROLE_ADMIN
                           and reset the fields the other kind cannot carry. #}
                        <div class="field">
                            <span class="field-label">Typ soutěže</span>
                            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                                <button type="button" data-action="live#action" data-live-action-param="usePrivateKind"
                                        class="option-card flex cursor-pointer items-start gap-3 text-left {{ not isGlobalKind ? 'selected' : '' }}">
                                    <twig:ux:icon name="lucide:users" class="mt-0.5 h-5 w-5 shrink-0 text-accent-300" />
                                    <span class="text-sm">
                                        <span class="block font-semibold text-white">Běžná soutěž</span>
                                        <span class="mt-1 block text-xs leading-relaxed text-white/50">Soukromá — hráči se přidají přes PIN, odkaz nebo e-mailovou pozvánku.</span>
                                    </span>
                                </button>
                                <button type="button" data-action="live#action" data-live-action-param="useGlobalKind"
                                        class="option-card flex cursor-pointer items-start gap-3 text-left {{ isGlobalKind ? 'selected' : '' }}">
                                    <twig:ux:icon name="lucide:globe" class="mt-0.5 h-5 w-5 shrink-0 text-draw" />
                                    <span class="text-sm">
                                        <span class="block font-semibold text-white">Globální soutěž</span>
                                        <span class="mt-1 block text-xs leading-relaxed text-white/50">Veřejná — kdokoli ji najde a přidá se za vstupné v kreditech.</span>
                                    </span>
                                </button>
                            </div>
                        </div>
                    {% endif %}

                    <div class="field">
                        <label class="field-label" for="wizard-name">Název soutěže</label>
                        <input id="wizard-name" type="text" class="input" placeholder="Např. Kámoši u piva"
                               data-model="norender|name" value="{{ name }}" maxlength="160" />
                    </div>

                    {# Popis soutěže (item 19) — nepovinný, uvidí ho členové v detailu soutěže. #}
                    <div class="field">
                        <label class="field-label" for="wizard-description">Popis soutěže</label>
                        <textarea id="wizard-description" class="input" rows="3" placeholder="Stručný popis soutěže…"
                                  data-model="norender|description"
                                  maxlength="{{ constant('App\\Entity\\Competition::DESCRIPTION_MAX_LENGTH') }}">{{ description }}</textarea>
                        <p class="text-xs leading-relaxed text-white/50">Nepovinné. Uvidí ho členové v detailu soutěže.</p>
                    </div>

                    {% if isGlobalKind %}
                        <div class="field">
                            <label class="field-label" for="wizard-entry-fee">Vstupné (kredity)</label>
                            <input id="wizard-entry-fee" type="number" min="0" class="input" data-model="entryFeeCredits" value="{{ entryFeeCredits }}" />
                            <p class="text-xs leading-relaxed text-white/50">0 = zdarma. Vstupné se strhne jednou při připojení a je nevratné.</p>
                        </div>
                    {% endif %}

                    {# ===== Košík zdrojů — co všechno se v soutěži tipuje ===== #}
                    {% if this.hasLayers %}
                        {% set draft = this.scopeDraft %}
                        <div class="space-y-3 border-t border-white/10 pt-5">
                            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                                <span class="field-label">Zápasy soutěže</span>
                                <span class="text-xs text-white/50">
                                    Celkem {{ draft.matchCount }} {{ draft.matchCount == 1 ? 'zápas' : (draft.matchCount < 5 ? 'zápasy' : 'zápasů') }}
                                    {%- if draft.firstKickoff %} · {{ draft.firstKickoff|date('j. n. Y', 'Europe/Prague') }}{% if draft.lastKickoff %} – {{ draft.lastKickoff|date('j. n. Y', 'Europe/Prague') }}{% endif %}{% endif %}
                                </span>
                            </div>

                            <div class="space-y-2">
                                {% for card in this.layerCards %}
                                    <div class="flex items-start justify-between gap-3 rounded-xl border border-white/10 bg-inset p-4">
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <twig:ux:icon name="{{ card.isOwnMatches ? 'lucide:pencil' : 'lucide:trophy' }}" class="h-4 w-4 shrink-0 text-white/40" />
                                                <span class="truncate text-sm font-semibold text-white">{{ card.name }}</span>
                                            </div>
                                            <p class="mt-1 text-xs leading-relaxed text-white/50">
                                                {{ card.scope }}{% if not card.isOwnMatches %} · {{ card.matchCount }} {{ card.matchCount == 1 ? 'zápas' : (card.matchCount < 5 ? 'zápasy' : 'zápasů') }}{% endif %}
                                            </p>
                                        </div>
                                        <div class="flex shrink-0 items-center gap-1">
                                            {% if not card.isOwnMatches %}
                                                <button type="button" class="btn btn-ghost btn-sm" data-action="live#action" data-live-action-param="editLayer" data-live-index-param="{{ card.index }}">Upravit</button>
                                            {% endif %}
                                            <button type="button" class="btn btn-ghost btn-sm" aria-label="Odebrat {{ card.name }}"
                                                    data-action="live#action" data-live-action-param="removeLayer" data-live-index-param="{{ card.index }}">
                                                <twig:ux:icon name="lucide:x" class="h-4 w-4" />
                                            </button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if draft.hasDuplicates %}
                                <div class="rounded-xl border border-amber-400/30 bg-amber-400/5 p-4">
                                    <div class="flex items-center gap-2">
                                        <twig:ux:icon name="lucide:triangle-alert" class="h-4 w-4 shrink-0 text-amber-300" />
                                        <span class="text-sm font-semibold text-amber-100">Některé zápasy máte v soutěži dvakrát</span>
                                    </div>
                                    <ul class="mt-2 space-y-1 text-xs leading-relaxed text-amber-100/70">
                                        {% for group in draft.duplicates %}
                                            <li>{{ group.label }} — ze zdrojů {{ group.sourceNames|join(' a ') }}</li>
                                        {% endfor %}
                                    </ul>
                                    <p class="mt-2 text-xs leading-relaxed text-amber-100/60">Hráči by je tipovali dvakrát. Pokud jde o odvetu nebo opakovaný zápas, nechte je být.</p>
                                </div>
                            {% endif %}

                            {% if not draftOpen %}
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-secondary btn-sm" data-action="live#action" data-live-action-param="startLayer">
                                        <twig:ux:icon name="lucide:plus" class="h-4 w-4" /> Přidat zdroj zápasů
                                    </button>
                                    {% if not isGlobalKind %}
                                        <button type="button" class="btn btn-ghost btn-sm" data-action="live#action" data-live-action-param="addOwnMatchesLayer">
                                            <twig:ux:icon name="lucide:pencil" class="h-4 w-4" /> Vlastní zápasy
                                        </button>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if draftOpen %}
                    {% if not isGlobalKind and not this.hasLayers %}
                        <label class="option-card flex cursor-pointer items-start gap-3 {{ fromScratch ? 'selected' : '' }}">
                            <input type="checkbox" class="mt-0.5 h-5 w-5 shrink-0 rounded border-white/20 bg-inset text-accent-500 focus:ring-accent-500"
                                   data-model="fromScratch" {{ fromScratch ? 'checked' }} />
                            <span class="text-sm">
                                <span class="block font-semibold text-white">Vytvořit soutěž od začátku</span>
                                <span class="mt-1 block text-xs leading-relaxed text-white/50">Bez šablony — zápasy, týmy a termíny doplníte ručně.</span>
                            </span>
                        </label>
                    {% endif %}

                    {% if fromScratch and not isGlobalKind %}
                        <div class="field">
                            <label class="field-label" for="wizard-sport">Sport</label>
                            <select id="wizard-sport" class="input" data-model="sportId">
                                {% for sport in this.availableSports %}
                                    <option value="{{ sport.id.toRfc4122 }}" {{ sportId == sport.id.toRfc4122 ? 'selected' }}>{{ sport.name }}</option>
                                {% endfor %}
                            </select>
                            <p class="text-xs leading-relaxed text-white/50">Sport určuje strukturu zápasu ({{ this.selectedSport.periodLabelPlural }}) a bodování.</p>
                        </div>
                    {% else %}
                        <div class="field">
                            <label class="field-label" for="wizard-source">Zdroj zápasů</label>
                            <select id="wizard-source" class="input" data-model="sourceId">
                                <option value="">Vyberte zdroj zápasů…</option>
                                {% for source in this.availableSources %}
                                    {% set dates = source.startAt ? source.startAt|date('j. n. Y', 'Europe/Prague') : '' %}
                                    {% set dates = source.endAt ? dates ~ '–' ~ source.endAt|date('j. n. Y', 'Europe/Prague') : dates %}
                                    <option value="{{ source.id.toRfc4122 }}" {{ sourceId == source.id.toRfc4122 ? 'selected' }}>
                                        {{ source.name }} · {{ source.sport.name }}{{ dates ? ' · ' ~ dates }}
                                    </option>
                                {% endfor %}
                            </select>
                            <p class="text-xs leading-relaxed text-white/50">{{ isGlobalKind ? 'Globální soutěž zahrnuje všechny zápasy vybraného zdroje.' : 'Rozpis zápasů, nad kterým se soutěž tipuje.' }}</p>
                        </div>

                        {% if this.selectedSource %}
                            <div class="space-y-3 border-t border-white/10 pt-5">
                                <span class="field-label">Zápasy soutěže</span>
                                <div class="grid grid-cols-1 gap-2 {{ isGlobalKind ? 'sm:grid-cols-2' : 'sm:grid-cols-3' }}">
                                    <label class="option-card flex cursor-pointer items-center gap-3 {{ selectionMode == 'all' ? 'selected' : '' }}">
                                        <input type="radio" name="wizard-selection-mode" value="all" data-model="selectionMode"
                                               class="h-4 w-4 shrink-0 border-white/20 bg-inset text-accent-500 focus:ring-accent-500" {{ selectionMode == 'all' ? 'checked' }} />
                                        <span class="text-sm font-medium text-white">Všechny zápasy</span>
                                    </label>
                                    <label class="option-card flex cursor-pointer items-center gap-3 {{ this.isTeams ? 'selected' : '' }}">
                                        <input type="radio" name="wizard-selection-mode" value="teams" data-model="selectionMode"
                                               class="h-4 w-4 shrink-0 border-white/20 bg-inset text-accent-500 focus:ring-accent-500" {{ this.isTeams ? 'checked' }} />
                                        <span class="text-sm font-medium text-white">Podle týmu</span>
                                    </label>
                                    {% if not isGlobalKind %}
                                        <label class="option-card flex cursor-pointer items-center gap-3 {{ this.isSubset ? 'selected' : '' }}">
                                            <input type="radio" name="wizard-selection-mode" value="subset" data-model="selectionMode"
                                                   class="h-4 w-4 shrink-0 border-white/20 bg-inset text-accent-500 focus:ring-accent-500" {{ this.isSubset ? 'checked' }} />
                                            <span class="text-sm font-medium text-white">Vybrat jen některé zápasy</span>
                                        </label>
                                    {% endif %}
                                </div>

                                {% if this.isTeams %}
                                    <div data-live-ignore>
                                        <div data-controller="team-filter"
                                             data-team-filter-url-value="{{ path('competition_source_filter_teams', {id: this.selectedSource.id.toRfc4122}) }}">
                                            <select multiple data-team-filter-target="select" class="input" aria-label="Týmy soutěže" placeholder="Vyhledat a přidat tým…">
                                                {% for option in this.filterTeamOptions %}
                                                    <option value="{{ option.id }}" selected>{{ option.name }}</option>
                                                {% endfor %}
                                            </select>
                                            <input type="hidden" data-model="norender|selectedTeamIdsCsv" data-team-filter-target="payload" value="{{ selectedTeamIdsCsv }}" />
                                        </div>
                                        <p class="mt-2 text-xs leading-relaxed text-white/50">Soutěž zahrne všechny zápasy vybraných týmů — i ty, které se do rozpisu přidají později (třeba playoff).</p>
                                    </div>
                                {% elseif this.isSubset %}
                                    <div data-controller="wizard-matches">
                                        <div class="relative mb-3">
                                            <twig:ux:icon name="lucide:search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-white/30" />
                                            <input type="text" class="input pl-9" placeholder="Filtrovat zápasy…"
                                                   data-wizard-matches-target="filter" data-action="input->wizard-matches#filter" />
                                        </div>

                                        {% for group, matches in this.groupedMatches %}
                                            <div class="mb-3 rounded-xl border border-white/10 bg-inset p-4" data-group-block data-wizard-matches-target="group">
                                                <div class="mb-2 flex items-center justify-between gap-3">
                                                    <span class="text-xs font-semibold uppercase tracking-wider text-white/50">{{ group }}</span>
                                                    <button type="button" class="btn btn-ghost btn-sm" data-action="wizard-matches#toggleGroup">Vybrat vše</button>
                                                </div>
                                                <div class="space-y-1.5">
                                                    {% for match in matches %}
                                                        <label class="flex cursor-pointer items-center gap-3" data-wizard-matches-target="row"
                                                               data-search="{{ (match.homeTeam.name ~ ' ' ~ match.awayTeam.name)|lower }}">
                                                            <input type="checkbox" class="h-4 w-4 shrink-0 rounded border-white/20 bg-inset text-accent-500 focus:ring-accent-500"
                                                                   data-model="norender|selectedMatchIds[]" value="{{ match.id.toRfc4122 }}"
                                                                   {{ match.id.toRfc4122 in selectedMatchIds ? 'checked' }} />
                                                            <span class="text-sm text-white/80">{{ match.homeTeam.name }} – {{ match.awayTeam.name }} <span class="text-white/40">({{ match.kickoffAt|date('j. n. Y H:i', 'Europe/Prague') }})</span></span>
                                                            {% if match.isPlayoff %}
                                                                <twig:Pill label="Playoff" variant="neutral" />
                                                            {% endif %}
                                                        </label>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {# „Dohrávat turnaj?" belongs to THIS layer: only mode „all"
                                   honours includePlayoff (subset keeps whatever was
                                   ticked, teams always includes playoff — see
                                   CompetitionMatchProvider), and the flag now lives on
                                   the zdroj's layer, so it cannot sit on a later step
                                   that has no layer in hand. Still exactly ONE control
                                   writing includePlayoff — never add a second. #}
                                {% if not isGlobalKind and selectionMode == 'all' %}
                                    <div class="border-t border-white/10 pt-4">
                                        <div class="mb-3 text-[11px] font-bold uppercase tracking-[0.14em] text-white/40">Dohrávat turnaj?</div>
                                        <label class="flex cursor-pointer items-start gap-3">
                                            <input type="checkbox" class="mt-0.5 h-5 w-5 shrink-0 rounded border-white/20 bg-inset text-accent-500 focus:ring-accent-500"
                                                   data-model="includePlayoff" {{ includePlayoff ? 'checked' }} />
                                            <span class="text-sm">
                                                <span class="block font-medium text-white">Ano, dohrajeme turnaj — zahrnout playoff zápasy</span>
                                                <span class="mt-1 block text-xs leading-relaxed text-white/50">Playoff zápasy přibývají do rozpisu postupně. Když turnaj dohrávat nebudete, soutěž se tipuje jen na základní část.</span>
                                            </span>
                                        </label>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endif %}

                    {# The way INTO a multi-zdroj soutěž. It must render as soon as the
                       editor holds a usable zdroj — gating it on „the basket already
                       has something" made the feature unreachable, because this was
                       also the only way to put the first thing in it. #}
                    {% if fromScratch or this.selectedSource %}
                        <div class="flex flex-wrap items-center gap-2 border-t border-white/10 pt-4">
                            {% if editingIndex is not null %}
                                <button type="button" class="btn btn-secondary btn-sm" data-action="live#action" data-live-action-param="addLayer">Uložit změnu</button>
                                <button type="button" class="btn btn-ghost btn-sm" data-action="live#action" data-live-action-param="cancelLayer">Zrušit</button>
                            {% else %}
                                <button type="button" class="btn btn-secondary btn-sm" data-action="live#action" data-live-action-param="addLayerAndContinue">
                                    <twig:ux:icon name="lucide:plus" class="h-4 w-4" /> Přidat další zdroj zápasů
                                </button>
                                {% if this.hasLayers %}
                                    <button type="button" class="btn btn-ghost btn-sm" data-action="live#action" data-live-action-param="cancelLayer">Zrušit</button>
                                {% endif %}
                                <span class="text-xs leading-relaxed text-white/40">Soutěž může kombinovat víc zdrojů — „Pokračovat" uloží i tenhle.</span>
                            {% endif %}
                        </div>
                    {% endif %}
                    {% endif %}{# draftOpen #}

                    {% if not draftOpen and not this.hasLayers %}
                        <button type="button" class="btn btn-secondary btn-sm" data-action="live#action" data-live-action-param="startLayer">
                            <twig:ux:icon name="lucide:plus" class="h-4 w-4" /> Přidat zdroj zápasů
                        </button>
                    {% endif %}
                </div>

            {# ================= KROK 2 — Pravidla ================= #}
            {% elseif step == 2 %}
                <div class="mb-6">
                    <span class="eyebrow">Krok {{ this.stepPosition }} ze {{ this.stepCount }}</span>
                    <h2 class="mt-1 text-2xl font-black tracking-tight text-white">Vyberte pravidla</h2>
                    <p class="mt-1 text-sm text-white/60">Bodování ovlivní pořadí v žebříčku. Hodnoty lze kdykoli upravit.</p>
                </div>

                <div data-controller="scoring-preset"
                     data-scoring-preset-defaults-value="{{ this.defaultPoints|json_encode }}"
                     data-scoring-preset-presets-value="{{ this.rulePresets|json_encode }}">
                    {# W1: Standardní / Maxi / Vlastní. „Standardní" is the pre-selected
                       default (it is exactly what mount() enables); „Vlastní" is visible
                       but disabled until the custom editor ships — the fields below stay
                       editable regardless, so nothing is lost. #}
                    <div class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
                        <button type="button" class="variant-card selected" data-scoring-preset-target="card" data-action="scoring-preset#standard">
                            <span class="variant-check" aria-hidden="true"><twig:ux:icon name="lucide:check" class="h-[18px] w-[18px]" /></span>
                            <span class="block text-[13px] font-bold">Standardní</span>
                            <span class="mt-[3px] block text-[11px] leading-snug text-white/40">Skóre + výsledek</span>
                        </button>
                        <button type="button" class="variant-card" data-scoring-preset-target="card" data-action="scoring-preset#maxi">
                            <span class="variant-check" aria-hidden="true"><twig:ux:icon name="lucide:check" class="h-[18px] w-[18px]" /></span>
                            <span class="block text-[13px] font-bold">Maxi</span>
                            <span class="mt-[3px] block text-[11px] leading-snug text-white/40">I části zápasu a prodloužení</span>
                        </button>
                        <button type="button" class="variant-card" data-scoring-preset-target="card" disabled aria-disabled="true">
                            <span class="variant-check" aria-hidden="true"><twig:ux:icon name="lucide:check" class="h-[18px] w-[18px]" /></span>
                            <span class="block text-[13px] font-bold">Vlastní (připravujeme)</span>
                            <span class="mt-[3px] block text-[11px] leading-snug text-white/40">Body si zatím upravte níže</span>
                        </button>
                    </div>

                    <div class="scoring-fields">
                        {% for section in this.ruleSections %}
                            <div class="mb-1 mt-4 first:mt-0">
                                <div class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/40">{{ section_headings[section.category] ?? section.heading }}</div>
                            </div>
                            {% for identifier in section.identifiers %}
                                {% set copy = rule_copy[identifier] ?? { label: identifier, sub: null } %}
                                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-b border-white/[0.06] py-3 last:border-b-0">
                                    <div class="min-w-0">
                                        <div class="field-label mb-0">{{ copy.label }}</div>
                                        {% if copy.sub %}
                                            <div class="mt-1 text-[13px] font-medium text-white">{{ copy.sub }}</div>
                                        {% endif %}
                                    </div>
                                    <div class="flex shrink-0 items-center gap-3">
                                        <label class="flex cursor-pointer items-center gap-2 text-sm text-white/70">
                                            <input type="checkbox" value="{{ identifier }}"
                                                   data-model="norender|enabledRuleIds[]"
                                                   data-scoring-preset-target="enabledField" data-rule="{{ identifier }}"
                                                   {{ identifier in enabledRuleIds ? 'checked' }} />
                                            <span class="cursor-pointer">Aktivní</span>
                                        </label>
                                        <input type="number" min="0" max="1000" class="num-input w-24"
                                               data-model="norender|rulePoints.{{ identifier }}"
                                               data-scoring-preset-target="field" data-rule="{{ identifier }}"
                                               value="{{ rulePoints[identifier] ?? this.defaultPoints[identifier] }}" />
                                    </div>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
                </div>

            {# ================= KROK 3 — Pozvánky ================= #}
            {% elseif step == 3 %}
                <div class="mb-6">
                    <span class="eyebrow">Krok {{ this.stepPosition }} ze {{ this.stepCount }}</span>
                    <h2 class="mt-1 text-2xl font-black tracking-tight text-white">Pozvěte hráče</h2>
                    <p class="mt-1 text-sm text-white/60">Vše je nepovinné — pozvat můžete kdykoli později z detailu soutěže.</p>
                </div>

                <div class="space-y-6">
                    <div class="field">
                        <label class="field-label">Odkaz na pozvánku</label>
                        <div class="copy-field" data-controller="copy">
                            <input type="text" readonly value="{{ url('competition_join_by_link', {token: shareableLinkToken}) }}" data-copy-target="source" />
                            <button type="button" data-action="copy#copy" data-copy-target="button" aria-label="Zkopírovat odkaz">
                                <twig:ux:icon name="lucide:copy" class="h-4 w-4" />
                            </button>
                        </div>
                        <p class="text-xs leading-relaxed text-white/50">Kdo odkaz otevře, rovnou se přidá do soutěže.</p>
                    </div>

                    <div class="space-y-3">
                        <label class="flex cursor-pointer items-start gap-3">
                            <input type="checkbox" class="mt-0.5 h-5 w-5 shrink-0 rounded border-white/20 bg-inset text-accent-500 focus:ring-accent-500"
                                   data-model="withPin" {{ withPin ? 'checked' }} />
                            <span class="text-sm">
                                <span class="block font-medium text-white">Vygenerovat PIN pro připojení</span>
                                <span class="mt-1 block text-xs leading-relaxed text-white/50">8místný kód — hráč ho zadá na <strong>wtips.cz/pripojit</strong> a hned se přidá.</span>
                            </span>
                        </label>

                        {% if withPin %}
                            <div class="copy-field" data-controller="copy">
                                <input type="text" readonly value="{{ pin }}" data-copy-target="source" class="font-mono tracking-[0.3em]" />
                                <button type="button" data-action="live#action" data-live-action-param="regeneratePin" aria-label="Vygenerovat nový PIN">
                                    <twig:ux:icon name="lucide:rotate-ccw" class="h-4 w-4" />
                                </button>
                                <button type="button" data-action="copy#copy" data-copy-target="button" aria-label="Zkopírovat PIN">
                                    <twig:ux:icon name="lucide:copy" class="h-4 w-4" />
                                </button>
                            </div>
                        {% endif %}
                    </div>

                    <div class="field">
                        <label class="field-label" for="wizard-emails">Pozvat e-mailem</label>
                        <textarea id="wizard-emails" class="input" rows="3" placeholder="jan@example.com, petr@example.com…"
                                  data-model="norender|inviteEmailsRaw">{{ inviteEmailsRaw }}</textarea>
                        <p class="text-xs leading-relaxed text-white/50">Adresy oddělte čárkou, mezerou nebo novým řádkem. Každý dostane pozvánku e-mailem.</p>
                    </div>
                </div>

            {# ================= KROK 4 — Podpora ================= #}
            {% elseif step == 4 %}
                {% if isGlobalKind %}
                    {# Admin global branch — entry-fee wording, unchanged by W4. #}
                    <div class="mb-6">
                        <span class="eyebrow">Krok {{ this.stepPosition }} ze {{ this.stepCount }}</span>
                        <h2 class="mt-1 flex items-center gap-2 text-2xl font-black tracking-tight text-white">
                            <twig:ux:icon name="lucide:coins" class="h-6 w-6 text-draw" />
                            Monetizace soutěže
                        </h2>
                        <p class="mt-1 text-sm text-white/60">Vstupné se strhává nezávisle. Tady vyberte, jak si hráči odemknou placené funkce (nebo je nechte vypnuté).</p>
                    </div>

                    {# None — a public competition is free of paid features by default. #}
                    <label class="option-card mb-3 flex cursor-pointer flex-col {{ monetization == 'none' ? 'selected' : '' }}">
                        <input type="radio" name="wizard-monetization" value="none" class="sr-only" data-model="monetization" {{ monetization == 'none' ? 'checked' }} />
                        <span class="flex items-center gap-2 text-sm font-bold text-white">
                            <twig:ux:icon name="lucide:circle-slash" class="h-5 w-5 text-win" />
                            Bez placených funkcí
                        </span>
                        <span class="mt-1 text-[13px] text-white/60">Soutěž běží jen na vstupné. Nikdo si nic nedokupuje, žádné boosty ani prémium.</span>
                    </label>

                    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
                        {# Premium #}
                        <label class="option-card relative flex cursor-pointer flex-col {{ monetization == 'premium' ? 'selected' : '' }}">
                            <input type="radio" name="wizard-monetization" value="premium" class="sr-only" data-model="monetization" {{ monetization == 'premium' ? 'checked' }} />
                            <span class="flex items-center gap-2 text-sm font-bold text-white">
                                <twig:ux:icon name="lucide:crown" class="h-5 w-5 text-draw" />
                                Zaplatím za celou skupinu
                            </span>
                            <span class="mt-1 text-[13px] text-white/60">{{ premiumPerPlayer }} kreditů × počet hráčů, zaúčtováno při připojení.</span>
                            {# Prémium switches the boosters on for everyone, so it names them
                               with their ONE canonical name from BoostType::label() (item 23). #}
                            <ul class="mt-3 space-y-1.5 text-[13px] text-white/70">
                                <li class="flex items-start gap-2"><twig:ux:icon name="lucide:check-check" class="mt-0.5 h-4 w-4 shrink-0 text-win" />„{{ constant('App\\Enum\\BoostType::TipDistribution').label }}“ i „{{ constant('App\\Enum\\BoostType::OthersTips').label }}“ pro všechny</li>
                                <li class="flex items-start gap-2"><twig:ux:icon name="lucide:check-check" class="mt-0.5 h-4 w-4 shrink-0 text-win" />Stejná uzávěrka pro celou skupinu</li>
                                <li class="flex items-start gap-2"><twig:ux:icon name="lucide:check-check" class="mt-0.5 h-4 w-4 shrink-0 text-win" />„{{ constant('App\\Enum\\BoostType::TipChange').label }}“ pro všechny</li>
                            </ul>
                        </label>

                        {# Boosts #}
                        <label class="option-card flex cursor-pointer flex-col {{ monetization == 'boosts' ? 'selected' : '' }}">
                            <input type="radio" name="wizard-monetization" value="boosts" class="sr-only" data-model="monetization" {{ monetization == 'boosts' ? 'checked' }} />
                            <span class="flex items-center gap-2 text-sm font-bold text-white">
                                <twig:ux:icon name="lucide:hand-coins" class="h-5 w-5 text-accent-300" />
                                Nechám příspěvek na jednotlivcích
                            </span>
                            <span class="mt-1 text-[13px] text-white/60">Soutěž je zdarma, každý hráč si může dokoupit vlastní vychytávky.</span>
                            <ul class="mt-3 space-y-1.5 text-[13px] text-white/70">
                                {% for boost in this.boostPrices %}
                                    <li class="flex items-center justify-between gap-2 border-b border-white/[0.06] pb-1.5 last:border-b-0">
                                        <span>{{ boost.label }}</span>
                                        <span class="font-bold text-white">{{ boost.price }} kr.</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </label>
                    </div>

                    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-white/10 bg-inset px-4 py-3">
                        <span class="flex items-center gap-2 text-sm text-white/70">
                            <twig:ux:icon name="lucide:wallet" class="h-4 w-4 text-accent-300" />
                            Váš zůstatek: <strong class="text-white">{{ this.creditBalance }} kreditů</strong>
                        </span>
                        {% if monetization == 'premium' %}
                            <a href="{{ path('credits') }}" class="btn btn-ghost btn-sm">
                                <twig:ux:icon name="lucide:plus" class="h-4 w-4" />Dokoupit kredity
                            </a>
                        {% endif %}
                    </div>
                    <p class="mt-2 text-xs leading-relaxed text-white/40">Teď se nic nestrhává — jen si volbu uložíme. Platby spustíme později.</p>
                {% else %}
                    {# W4: „Pozvete nás na pivo?" — Premium XOR boosts, one `monetization`
                       column (DOMAIN.md). Férová soutěž = Premium (the organizer decides
                       for everyone, nobody buys an individual edge, pre-selected default);
                       Volná volba Premium = Boosts (each player decides for themselves). #}
                    <div class="mb-6">
                        <span class="eyebrow">Krok {{ this.stepPosition }} ze {{ this.stepCount }}</span>
                        <h2 class="mt-1 flex items-center gap-2 text-2xl font-black tracking-tight text-white">
                            <twig:ux:icon name="lucide:beer" class="h-6 w-6 text-draw" />
                            Pozvete nás na pivo?
                        </h2>
                        <div class="mt-3 space-y-3 text-sm leading-relaxed text-white/60">
                            <p>Tipovačka je kompletně zdarma. Výsledky se zapisují automaticky, tabulka se počítá sama a vy si můžete užívat soutěž bez zbytečné administrativy.</p>
                            <p>Vytvořili jsme ji, protože nás baví sport stejně jako vás. Neustále ji rozvíjíme, přidáváme nové funkce a chceme, aby byla nejlepší tipovačkou na trhu.</p>
                            <p>Teď už jen rozhodněte, jak budou ve vaší soutěži fungovat prémiové funkce.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
                        {# Férová soutěž = Premium #}
                        <label class="option-card relative flex cursor-pointer flex-col {{ monetization == 'premium' ? 'selected' : '' }}">
                            <span class="badge badge-organizer absolute right-3 top-3 flex items-center gap-1 text-[10px] uppercase tracking-wider">
                                <twig:ux:icon name="lucide:star" class="h-3 w-3" />Doporučujeme
                            </span>
                            <span class="flex items-center gap-2 pr-36 text-sm font-bold text-white">
                                <twig:ux:icon name="lucide:crown" class="h-5 w-5 text-draw" />
                                Férová soutěž
                            </span>
                            <span class="mt-2 text-[13px] leading-relaxed text-white/60">Nikdo nebude moci získat individuální výhodu zakoupením Premium funkcí. Pokud se později rozhodnete Premium aktivovat, budou dostupné všem hráčům za stejných podmínek.</span>
                            <span class="mt-2 text-[13px] leading-relaxed text-white/60">V případě aktivace Premium rozhodujete o podpoře aplikace vy jako administrátor soutěže.</span>
                            <span class="mt-auto flex items-center gap-2 pt-4 text-[13px] font-semibold text-white">
                                <input type="radio" name="wizard-monetization" value="premium"
                                       class="h-4 w-4 shrink-0 border-white/20 bg-inset text-accent-500 focus:ring-accent-500"
                                       data-model="monetization" {{ monetization == 'premium' ? 'checked' }} />
                                Chci hrát Férovou soutěž
                            </span>
                        </label>

                        {# Volná volba Premium = Boosts #}
                        <label class="option-card flex cursor-pointer flex-col {{ monetization == 'boosts' ? 'selected' : '' }}">
                            <span class="flex items-center gap-2 text-sm font-bold text-white">
                                <twig:ux:icon name="lucide:hand-coins" class="h-5 w-5 text-accent-300" />
                                Volná volba Premium
                            </span>
                            <span class="mt-2 text-[13px] leading-relaxed text-white/60">Každý hráč se během soutěže rozhodne sám, zda si chce aktivovat Premium funkce a podpořit tak další vývoj aplikace.</span>
                            <span class="mt-auto flex items-center gap-2 pt-4 text-[13px] font-semibold text-white">
                                <input type="radio" name="wizard-monetization" value="boosts"
                                       class="h-4 w-4 shrink-0 border-white/20 bg-inset text-accent-500 focus:ring-accent-500"
                                       data-model="monetization" {{ monetization == 'boosts' ? 'checked' }} />
                                Chci ponechat rozhodnutí na hráčích
                            </span>
                        </label>
                    </div>
                {% endif %}
            {% endif %}
        </div>

        {# ---- Footer nav ---- #}
        <div class="flex items-center justify-between gap-3 border-t border-white/10 px-6 py-5 sm:px-8">
            <div>
                {% if step > 1 %}
                    <button type="button" class="btn btn-ghost" data-action="live#action" data-live-action-param="back">
                        <twig:ux:icon name="lucide:chevron-left" class="h-4 w-4" />Zpět
                    </button>
                {% endif %}
            </div>
            <div class="flex items-center gap-3">
                {% if step == 3 %}
                    {# W3: bare „Přeskočit" — the step heading already says invites are optional. #}
                    <button type="button" class="btn btn-link text-sm" data-action="live#action" data-live-action-param="next">Přeskočit</button>
                {% endif %}
                {% if not this.isLastStep %}
                    <button type="button" class="btn btn-primary" data-action="live#action" data-live-action-param="next">
                        Pokračovat<twig:ux:icon name="lucide:chevron-right" class="h-4 w-4" />
                    </button>
                {% else %}
                    <button type="button" class="btn btn-primary" data-action="live#action" data-live-action-param="submit">
                        <twig:ux:icon name="lucide:party-popper" class="h-4 w-4" />
                        {# W4: no „Vytvořit a přispět" any more — the new step-4 copy charges
                           nothing at creation; Premium is activated later, if at all. #}
                        {{ isGlobalKind ? 'Vytvořit globální soutěž' : 'Vytvořit soutěž' }}
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>
