{#
    Soutěž (Competition) switcher — a grouped tom-select picker.

    Class-based component: src/Twig/Components/SoutezSwitcher.php
    Docs: .docs/features/competition-switcher.md

    props:
      competitions : list<CompetitionListItem> (ListMyCompetitions) — the viewer's soutěže,
                     or list<DiscoverableGlobalCompetitionItem> (ListDiscoverableGlobalCompetitions)
                     for the logged-out variant. One component, two feeds.
      currentId    : string|null — RFC4122 id of the active soutěž. An unknown/foreign id
                     silently falls back to the first option (deliberate leak prevention).
      route        : string — route the GET form submits to. It must be reachable WITHOUT any
                     path parameter, because a no-JS <form> can only append a query string.
      param        : string — query parameter carrying the chosen id (default 'soutez').
      label        : string — eyebrow label above the control.
      id           : string — DOM id of the <select>; override when a page renders two switchers.

    Progressive enhancement: this is a real <select> in a real <form>. Without JavaScript the
    native control renders (see the „item 04" block in app.css, which undoes the global
    `select[data-controller~="tom-select"] { opacity: 0 }` FOUC guard when scripting is off)
    and the <noscript> button submits it. With JavaScript, tom-select upgrades it to a
    searchable, grouped dropdown that submits on change.

    Edge cases: zero soutěží renders nothing, exactly one renders a static chip.
#}
{% if this.current is not null %}
    <div{{ attributes.defaults({ class: 'soutez-switcher w-full min-w-0 sm:w-72' }) }}>
        {% if this.options|length == 1 %}
            <span class="stat-lbl mb-1.5 block">{{ label }}</span>
            <div class="inline-flex max-w-full items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3.5 py-2">
                <twig:ux:icon name="lucide:users" class="h-4 w-4 shrink-0 text-accent-300" />
                <span class="truncate text-sm font-semibold text-white">{{ this.current.name }}</span>
            </div>
        {% else %}
            <form method="get" action="{{ path(route) }}" class="field">
                <label for="{{ id }}">{{ label }}</label>
                <select
                    id="{{ id }}"
                    name="{{ param }}"
                    data-controller="tom-select"
                    data-tom-select-submit-on-change-value="true"
                    data-tom-select-placeholder-value="Vyhledejte soutěž…"
                    data-tom-select-no-results-text-value="Žádná soutěž nenalezena"
                >
                    {% for group in this.groups %}
                        <optgroup label="{{ group.label }}">
                            {% for option in group.options %}
                                <option
                                    value="{{ option.id }}"
                                    data-sub="{{ option.subtitle }}"
                                    {% if option.dateRange != '' %}data-meta="{{ option.dateRange }}"{% endif %}
                                    {% if option.id == this.current.id %}selected{% endif %}
                                >{{ option.name }}</option>
                            {% endfor %}
                        </optgroup>
                    {% endfor %}
                </select>
                <noscript>
                    <button type="submit" class="btn btn-ghost btn-sm self-start">
                        Zobrazit soutěž
                    </button>
                </noscript>
            </form>
        {% endif %}
    </div>
{% endif %}
