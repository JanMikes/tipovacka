{#
    „Nastavení oznámení" (Live Component) — three sections from the broadest to the finest:
    how often we may e-mail, which soutěže are silenced, which type goes to which channel.
    Every control saves at once (`this.setFrequency` / `setDigestHour` / `toggleMute` /
    `toggle`) and re-renders.
#}
{% set emails_off = this.frequency.value == 'never' %}
<div {{ attributes.defaults({ class: 'space-y-8' }) }}>
    {# Every change saves at once; this line confirms it in place (a flash would only
       show on the next page load). Always rendered so screen readers announce it. #}
    <p class="-mb-4 flex min-h-5 items-center gap-1.5 px-1 text-[13px] font-medium text-win" role="status" aria-live="polite">
        {% if savedMessage %}
            <twig:ux:icon name="lucide:circle-check-big" class="h-4 w-4 shrink-0" />
            {{ savedMessage }}
        {% endif %}
    </p>

    {# ── 1. How often ── #}
    <section aria-labelledby="pref-frequency">
        <h2 id="pref-frequency" class="text-base font-bold text-white">Jak často vám máme psát e-mailem</h2>
        <p class="mt-1 text-[13px] text-white/50">Platí pro všechna oznámení níže. E-maily k účtu (heslo, potvrzení platby) chodí vždy.</p>

        <div class="mt-3 grid gap-2 sm:grid-cols-3" role="radiogroup" aria-labelledby="pref-frequency">
            {% for option in this.frequencies %}
                {% set selected = option == this.frequency %}
                <button
                    type="button"
                    data-action="live#action:prevent"
                    data-live-action-param="setFrequency"
                    data-live-frequency-param="{{ option.value }}"
                    role="radio"
                    aria-checked="{{ selected ? 'true' : 'false' }}"
                    class="card flex flex-col gap-1 p-4 text-left transition {{ selected ? 'border-accent-400 bg-accent-500/[0.08]' : 'hover:border-white/20' }}"
                >
                    <span class="flex items-center gap-2 text-sm font-bold text-white">
                        <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full border {{ selected ? 'border-accent-400' : 'border-white/30' }}">
                            {% if selected %}<span class="h-2 w-2 rounded-full bg-accent-400"></span>{% endif %}
                        </span>
                        {{ option.label }}
                    </span>
                    <span class="text-[13px] leading-snug text-white/50">{{ option.description }}</span>
                </button>
            {% endfor %}
        </div>

        {% if this.frequency.value == 'daily' %}
            <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="text-[13px] text-white/60">Souhrn posílat po:</span>
                {% for hour in this.digestHours %}
                    <button
                        type="button"
                        data-action="live#action:prevent"
                        data-live-action-param="setDigestHour"
                        data-live-hour-param="{{ hour }}"
                        aria-pressed="{{ hour == this.digestHour ? 'true' : 'false' }}"
                        class="rounded-full border px-3 py-1 text-[13px] font-semibold tabular-nums transition {{ hour == this.digestHour ? 'border-accent-400 bg-accent-500/15 text-white' : 'border-white/15 text-white/60 hover:border-white/30 hover:text-white' }}"
                    >{{ hour }}:00</button>
                {% endfor %}
            </div>
            <p class="mt-2 text-[13px] text-white/40">V souhrnu najdete i tipy, kterým končí uzávěrka během následujícího dne a půl. Den, kdy není co napsat, nic nepošleme.</p>
        {% endif %}
    </section>

    {# ── 2. Which soutěže ── #}
    {% if this.competitions is not empty %}
        <section aria-labelledby="pref-competitions">
            <h2 id="pref-competitions" class="text-base font-bold text-white">Soutěže</h2>
            <p class="mt-1 text-[13px] text-white/50">Ztlumená soutěž neposílá žádná oznámení ani e-maily a její zápasy vynecháme z připomínek. Hrajete v ní dál; upozornění na kredity chodí i tak.</p>

            <div class="mt-3 space-y-2">
                {% for competition in this.competitions %}
                    <div class="card flex items-center gap-4 p-4">
                        <div class="min-w-0 flex-1">
                            <div class="truncate text-sm font-bold text-white">{{ competition.name }}</div>
                            <div class="text-[13px] {{ competition.muted ? 'text-draw' : 'text-white/50' }}">{{ competition.muted ? 'Ztlumeno' : 'Oznámení zapnuta' }}</div>
                        </div>
                        <button
                            type="button"
                            data-action="live#action:prevent"
                            data-live-action-param="toggleMute"
                            data-live-competition-param="{{ competition.id }}"
                            role="switch"
                            aria-checked="{{ competition.muted ? 'false' : 'true' }}"
                            aria-label="Oznámení ze soutěže {{ competition.name }}"
                            class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors {{ competition.muted ? 'bg-white/15' : 'bg-accent-500' }}"
                        >
                            <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform {{ competition.muted ? 'translate-x-1' : 'translate-x-6' }}"></span>
                        </button>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ── 3. Which types, on which channel ── #}
    <section aria-labelledby="pref-types">
        <h2 id="pref-types" class="text-base font-bold text-white">Typy oznámení</h2>
        <p class="mt-1 text-[13px] text-white/50">
            {% if emails_off %}
                E-maily máte vypnuté úplně — sloupec E-mail se použije, až je zase zapnete.
            {% else %}
                Vyberte, o čem chcete vědět v aplikaci a o čem i e-mailem.
            {% endif %}
        </p>

        {% for group in this.groups %}
            <div class="mt-5 flex items-center gap-4 px-4 pb-1.5 text-[11px] font-semibold uppercase tracking-wide text-white/40">
                <span class="flex-1">{{ group.category.label }}</span>
                <span class="hidden w-20 text-center sm:block">V aplikaci</span>
                <span class="hidden w-20 text-center sm:block">E-mail</span>
            </div>

            <div class="space-y-2">
                {% for row in group.rows %}
                    <div class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 text-sm font-bold text-white">
                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] {{ row.type.tone }}">
                                    <twig:ux:icon name="lucide:{{ row.type.icon }}" class="h-4 w-4" />
                                </span>
                                {{ row.type.label }}
                            </div>
                            <p class="mt-1 text-[13px] text-white/50">{{ row.type.description }}</p>
                        </div>

                        <div class="flex items-center gap-8 sm:gap-0">
                            {% for channel in [{ key: 'inApp', on: row.inApp, label: 'V aplikaci', dim: false }, { key: 'email', on: row.email, label: 'E-mail', dim: emails_off }] %}
                                <div class="flex w-20 flex-col items-center gap-1 {{ channel.dim ? 'opacity-40' : '' }}">
                                    <span class="text-[11px] text-white/40 sm:hidden">{{ channel.label }}</span>
                                    <button
                                        type="button"
                                        data-action="live#action:prevent"
                                        data-live-action-param="toggle"
                                        data-live-type-param="{{ row.type.value }}"
                                        data-live-channel-param="{{ channel.key }}"
                                        role="switch"
                                        aria-checked="{{ channel.on ? 'true' : 'false' }}"
                                        aria-label="{{ channel.label }} — {{ row.type.label }}"
                                        class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors {{ channel.on ? 'bg-accent-500' : 'bg-white/15' }}"
                                    >
                                        <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform {{ channel.on ? 'translate-x-6' : 'translate-x-1' }}"></span>
                                    </button>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </section>
</div>
