<div{{ attributes }}>
    {{ form_start(form, {attr: {class: 'flex flex-col gap-5', novalidate: 'novalidate', 'data-model': 'on(change)|*', 'data-action': 'live#action:prevent', 'data-live-action-param': 'save'}}) }}

        <div class="field">
            {{ form_label(form.currentPassword, null, {label_attr: {class: 'field-label'}}) }}
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-white/50">
                    <twig:ux:icon name="lucide:lock" class="h-[18px] w-[18px]" />
                </span>
                {{ form_widget(form.currentPassword, {attr: {class: 'input !pl-[42px]'}}) }}
            </div>
            {{ form_errors(form.currentPassword) }}
            <p class="mt-1 text-xs leading-relaxed text-white/45">
                Nepamatujete si ho? <a href="{{ path('app_forgot_password_request') }}" class="font-semibold text-accent-300 hover:text-accent-200">Obnovte si heslo e-mailem</a>.
            </p>
        </div>

        <div class="field" data-controller="password-visibility">
            {{ form_label(form.newPassword.first, null, {label_attr: {class: 'field-label'}}) }}
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-white/50">
                    <twig:ux:icon name="lucide:key-round" class="h-[18px] w-[18px]" />
                </span>
                {{ form_widget(form.newPassword.first, {attr: {class: 'input !pl-[42px] pr-12', 'data-password-visibility-target': 'input'}}) }}
                <button type="button" data-action="password-visibility#toggle" class="absolute inset-y-0 right-2 flex items-center rounded-md px-2 text-white/40 transition-colors hover:text-white" aria-label="Zobrazit nebo skrýt heslo">
                    <span data-password-visibility-target="iconShow"><twig:ux:icon name="lucide:eye" class="h-5 w-5" /></span>
                    <span class="hidden" data-password-visibility-target="iconHide"><twig:ux:icon name="lucide:eye-off" class="h-5 w-5" /></span>
                </button>
            </div>
            {{ form_help(form.newPassword.first) }}
            {{ form_errors(form.newPassword.first) }}
        </div>

        <div class="field">
            {{ form_label(form.newPassword.second, null, {label_attr: {class: 'field-label'}}) }}
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-white/50">
                    <twig:ux:icon name="lucide:key-round" class="h-[18px] w-[18px]" />
                </span>
                {{ form_widget(form.newPassword.second, {attr: {class: 'input !pl-[42px]'}}) }}
            </div>
            {{ form_errors(form.newPassword.second) }}
            {{ form_errors(form.newPassword) }}
        </div>

        {# An error of the whole form (none today, but a Live re-render must never
           swallow one) — field errors sit under their fields. #}
        {{ form_errors(form) }}

        <button type="submit" class="btn btn-primary mt-1 self-start">
            <twig:ux:icon name="lucide:shield-check" class="h-4 w-4" />
            Změnit heslo
        </button>

    {{ form_end(form) }}
</div>
