{#
    The nickname rule, stated BEFORE the visitor trips over it, plus — once the typed
    nickname is rejected — a free one the rules accept, one tap away.
    Expects `field` (the nickname FormView) and `suggestion` (?string).
#}
<p class="mt-1 text-xs leading-relaxed text-white/45">3–30 znaků, <strong class="font-semibold text-white/70">bez mezer a diakritiky</strong> — písmena, čísla, podtržítko, tečka nebo pomlčka (např. jan.novak).</p>
{{ form_errors(field) }}
{% if suggestion %}
    <p class="mt-1.5 flex flex-wrap items-center gap-2 text-sm text-white/70">
        Volná přezdívka:
        <button type="button"
                data-action="signup-feedback#fill"
                data-signup-feedback-field-param="nickname"
                data-signup-feedback-value-param="{{ suggestion }}"
                class="inline-flex items-center gap-1 rounded-lg border border-accent-500/40 bg-accent-500/10 px-2 py-0.5 font-mono text-[13px] font-semibold text-accent-200 transition-colors hover:bg-accent-500/20">
            {{ suggestion }}
            <span class="font-sans text-xs font-medium text-accent-300">použít</span>
        </button>
    </p>
{% endif %}
