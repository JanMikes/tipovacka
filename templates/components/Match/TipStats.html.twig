{#
    „Jak tipují ostatní?" for one match inside one soutěž — the SINGLE surface used by
    every match list. Renders off a prepared App\Value\TipStats (built in bulk by
    App\Service\Competition\TipStatsProvider — never resolve one per row):

      visible                → the 1 / X / 2 split
      boosts, not entitled   → locked placeholder; clicking it opens the buy modal
      premium, not entitled  → the organizer switches this on for everyone
      none, not entitled     → plain note: it appears once the match is played

    props:
      stats       (TipStats)  required
      homeTeam    TeamView|Team|null  labels the bars
      awayTeam    TeamView|Team|null
      compact     bool         true = the strip that lives INSIDE a match card
                               (item 11 — below the divider of `Match/MatchRow`;
                               it must never be placed on its own again), default,
                               false = the full „Jak tipují ostatní?" card (item 10),
                               with labelled bars carrying an absolute count AND a
                               percentage, and a paywalled twin behind a lock coin

    Never the word „sázka" or its verb forms (DOMAIN.md) — players tipují.
#}
{% props stats, homeTeam = null, awayTeam = null, compact = true %}

{# The boost that unlocks this surface names AND describes itself — BoostType is
   the single source for both, so the paywall can never drift from the shop again
   (items 12 + 23). The competition scope and the price are transactional context
   the enum cannot know, so they stay here. #}
{% set dist_boost = constant('App\\Enum\\BoostType::TipDistribution') %}
{% set dist_boost_label = dist_boost.label %}
{% set dist_boost_description = dist_boost.description %}

{% if not compact %}
    {# ═════════ Full card (match detail) ═════════ #}
    {% set mon = stats.monetization.value %}

    <section class="card-glass dist-card p-5 sm:p-6{{ stats.visible ? '' : ' is-locked' }}">
        <header class="dist-card-head">
            <div class="flex min-w-0 flex-wrap items-center gap-2.5">
                {% if stats.visible and stats.entitled and mon == 'premium' %}
                    <twig:Pill label="Prémium" variant="success" icon="check" />
                {% elseif stats.visible and stats.entitled and mon == 'boosts' %}
                    <twig:Pill label="Odemčeno" variant="success" icon="check" />
                {% elseif stats.visible %}
                    {# Visible without an entitlement ⇒ the match is played (item 20). #}
                    <twig:Pill label="Odehráno" variant="neutral" icon="unlock" />
                {% elseif mon == 'premium' %}
                    <twig:Pill label="Prémium" variant="warn" icon="crown" />
                {% elseif mon == 'boosts' %}
                    <twig:Pill label="Vylepšení" variant="warn" icon="sparkles" />
                {% else %}
                    <twig:Pill label="Zamčeno" variant="locked" icon="lock" />
                {% endif %}
                <h2 class="eyebrow">Jak tipují ostatní?</h2>
            </div>

            {% if not stats.visible and stats.purchasable %}
                {% if stats.canAfford %}
                    <form method="post"
                          action="{{ path('competition_boost_purchase', {id: stats.competitionId.toRfc4122}) }}"
                          class="dist-buy"
                          data-controller="confirm"
                          data-confirm-variant-value="warning"
                          data-confirm-title-value="Odemknout „{{ dist_boost_label }}“"
                          data-confirm-message-value="{{ dist_boost_description }} Platí pro všechny zápasy v soutěži „{{ stats.competitionName }}“. Za {{ stats.price }} kr. z vašeho zůstatku ({{ stats.balance }} kr.)."
                          data-confirm-confirm-label-value="Koupit za {{ stats.price }} kr.">
                        <input type="hidden" name="_token" value="{{ csrf_token('boost_purchase_' ~ stats.competitionId.toRfc4122) }}">
                        <input type="hidden" name="type" value="tip_distribution">
                        <input type="hidden" name="_redirect" value="{{ app.request.requestUri }}">
                        <button type="submit" class="dist-unlock card-raise group">
                            Odemknout za {{ stats.price }} kr.
                            <twig:ux:icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                        </button>
                        {# B27 — the whole card is the same purchase: a submit stretched
                           over it, a SIBLING of the button above (nothing interactive may
                           be nested inside it). Rendered hidden and unhidden by the
                           `confirm` controller on connect, so a page whose JavaScript never
                           ran keeps only the explicit button. #}
                        <button type="submit" data-confirm-target="stretch" class="card-stretch" hidden>
                            Odemknout „{{ dist_boost_label }}“ za {{ stats.price }} kr.
                        </button>
                    </form>
                {% else %}
                    {# Same CTA, same price, only the destination differs: a wallet that
                       cannot cover the boost goes to dobití first (item 23). Never a
                       „Chybí kredity" label — the offer is the offer. #}
                    <a href="{{ path('credits') }}#dobit" class="dist-unlock group">
                        Odemknout za {{ stats.price }} kr.
                        <twig:ux:icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                    </a>
                {% endif %}
            {% elseif not stats.visible and mon == 'premium' %}
                <span class="dist-unlock is-static">{{ constant('App\\Enum\\BoostType::LOCKED_PREMIUM_CTA') }}</span>
            {% endif %}
        </header>

        {% if stats.visible %}
            {% if stats.total > 0 %}
                <div class="mt-4 space-y-3.5">
                    {% for bar in [
                        {label: 'Výhra ' ~ (homeTeam ? homeTeam.name : 'domácích'), count: stats.homeWinCount, percent: stats.homeWinPercent, fill: 'f1'},
                        {label: 'Remíza', count: stats.drawCount, percent: stats.drawPercent, fill: 'fx'},
                        {label: 'Výhra ' ~ (awayTeam ? awayTeam.name : 'hostů'), count: stats.awayWinCount, percent: stats.awayWinPercent, fill: 'f2'},
                    ] %}
                        <div class="dist-row">
                            <div class="dist-row-head">
                                <span class="dist-row-label">{{ bar.label }}</span>
                                <span class="dist-row-val"><b>{{ bar.count }}</b> · {{ bar.percent }} %</span>
                            </div>
                            <div class="dist-track">
                                <div class="dist-fill {{ bar.fill }}" style="width: {{ bar.percent }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% else %}
            {# Decorative skeleton only — no counts, no percentages, nothing to read. #}
            <div class="dist-veil">
                <div aria-hidden="true" class="dist-skeleton space-y-3.5">
                    {% for width in [58, 22, 20] %}
                        <div class="dist-row">
                            <div class="dist-row-head">
                                <span class="dist-row-ghost"></span>
                                <span class="dist-row-ghost is-short"></span>
                            </div>
                            <div class="dist-track">
                                <div class="dist-ghost-fill {{ loop.first ? 'f1' : (loop.last ? 'f2' : 'fx') }}" style="width: {{ width }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# The header above already carries the booster's ONE name, so the
                   overlay adds only its ONE sentence — no invented teaser. With
                   nothing to sell („none") the sentence would promise a purchase
                   that does not exist, so the state constant speaks instead. #}
                <div class="dist-lock">
                    <span class="dist-lock-coin"><twig:ux:icon name="lucide:lock" class="h-5 w-5" /></span>
                    <p class="dist-lock-note">
                        {{- mon == 'none'
                            ? constant('App\\Enum\\BoostType::LOCKED_AFTER_MATCH_NOTE')
                            : dist_boost_description -}}
                    </p>
                </div>
            </div>
        {% endif %}
    </section>

{% elseif stats.hasAnythingToShow %}
    {% set players = stats.total ~ ' ' ~ (stats.total == 1 ? 'hráč' : (stats.total <= 4 ? 'hráči' : 'hráčů')) %}
    {# The locked strip sells the booster with the booster's OWN sentence — the same
       one the shop row, the confirm dialog and /cenik render. It used to count the
       players („Uvidíš, jak tipují 4 hráči"), which was a second vocabulary for the
       same product; the count still belongs to the UNLOCKED strip, where it is data
       rather than bait. #}
    {% set teaser = dist_boost_description %}
    {# item 11: the paywalled strip lives INSIDE the match card. The hatched bar is
       a stand-in for the hidden split — fixed proportions, it leaks nothing. #}
    {% set ghost %}
        <span class="tip-stats-ghost" aria-hidden="true"><i class="g1"></i><i class="gx"></i><i class="g2"></i></span>
    {% endset %}

    {% if stats.visible %}
        {# ───────── Unlocked: the actual split ───────── #}
        <div class="tip-stats-open">
            <div class="tip-stats-head">
                <p class="tip-stats-eyebrow">Jak tipují ostatní?</p>
                <span class="tip-stats-count">{{ players }}</span>
            </div>
            <div class="dist-pcts">
                <span><span class="k1">1</span>{{ stats.homeWinPercent }} %</span>
                <span><span class="kx">X</span>{{ stats.drawPercent }} %</span>
                <span><span class="k2">2</span>{{ stats.awayWinPercent }} %</span>
            </div>
            <div class="dist-bar">
                {% if stats.homeWinPercent > 0 %}<div class="b1" style="width: {{ stats.homeWinPercent }}%"></div>{% endif %}
                {% if stats.drawPercent > 0 %}<div class="bx" style="width: {{ stats.drawPercent }}%"></div>{% endif %}
                {% if stats.awayWinPercent > 0 %}<div class="b2" style="width: {{ stats.awayWinPercent }}%"></div>{% endif %}
            </div>
        </div>

    {% elseif stats.purchasable %}
        {# ───────── Locked, buyable: the whole strip is the buy trigger ───────── #}
        {% if stats.canAfford %}
            <form method="post"
                  action="{{ path('competition_boost_purchase', {id: stats.competitionId.toRfc4122}) }}"
                  class="block"
                  data-controller="confirm"
                  data-confirm-variant-value="warning"
                  data-confirm-title-value="Odemknout „{{ dist_boost_label }}“"
                  data-confirm-message-value="{{ dist_boost_description }} Platí pro všechny zápasy v soutěži „{{ stats.competitionName }}“. Za {{ stats.price }} kr. z vašeho zůstatku ({{ stats.balance }} kr.)."
                  data-confirm-confirm-label-value="Koupit za {{ stats.price }} kr.">
                <input type="hidden" name="_token" value="{{ csrf_token('boost_purchase_' ~ stats.competitionId.toRfc4122) }}">
                <input type="hidden" name="type" value="tip_distribution">
                <input type="hidden" name="_redirect" value="{{ app.request.requestUri }}">
                <button type="submit" class="tip-stats-locked group">
                    <span class="tip-stats-head">
                        <span class="pill pill-warn"><twig:ux:icon name="lucide:sparkles" class="h-3 w-3" />Vylepšení</span>
                        <span class="tip-stats-eyebrow">Jak tipují ostatní?</span>
                        <span class="tip-stats-note">
                            <span class="tip-stats-lock"><twig:ux:icon name="lucide:lock" class="h-3.5 w-3.5" /></span>
                            <span class="tip-stats-teaser">{{ teaser }}</span>
                        </span>
                        <span class="tip-stats-cta">
                            Odemknout za {{ stats.price }} kr.
                            <twig:ux:icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                        </span>
                    </span>
                    {{ ghost }}
                </button>
            </form>
        {% else %}
            {# The strip is identical to the affordable one — same CTA, same price; it
               just leads to dobití instead of the confirm dialog (item 23). #}
            <a href="{{ path('credits') }}#dobit" class="tip-stats-locked group">
                <span class="tip-stats-head">
                    <span class="pill pill-warn"><twig:ux:icon name="lucide:sparkles" class="h-3 w-3" />Vylepšení</span>
                    <span class="tip-stats-eyebrow">Jak tipují ostatní?</span>
                    <span class="tip-stats-note">
                        <span class="tip-stats-lock"><twig:ux:icon name="lucide:lock" class="h-3.5 w-3.5" /></span>
                        <span class="tip-stats-teaser">{{ teaser }}</span>
                    </span>
                    <span class="tip-stats-cta">
                        Odemknout za {{ stats.price }} kr.
                        <twig:ux:icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                    </span>
                </span>
                {{ ghost }}
            </a>
        {% endif %}

    {% elseif stats.monetization.value == 'premium' %}
        {# ───────── Locked, premium: the organizer toggles it for everyone ───────── #}
        <div class="tip-stats-locked is-premium">
            <span class="tip-stats-head">
                <span class="pill pill-warn"><twig:ux:icon name="lucide:crown" class="h-3 w-3" />Prémium</span>
                <span class="tip-stats-eyebrow">Jak tipují ostatní?</span>
                <span class="tip-stats-note">
                    <span class="tip-stats-lock is-premium"><twig:ux:icon name="lucide:lock" class="h-3.5 w-3.5" /></span>
                    <span class="tip-stats-teaser">{{ teaser }}</span>
                </span>
                <span class="tip-stats-cta is-premium">{{ constant('App\\Enum\\BoostType::LOCKED_PREMIUM_CTA') }}</span>
            </span>
            {{ ghost }}
        </div>

    {% else %}
        {# ───────── Locked, nothing to sell: it opens once the match is played ───────── #}
        <div class="tip-stats-locked is-muted">
            <span class="tip-stats-head">
                <span class="tip-stats-eyebrow">Jak tipují ostatní?</span>
                <span class="tip-stats-note">
                    <span class="tip-stats-lock is-muted"><twig:ux:icon name="lucide:lock" class="h-3.5 w-3.5" /></span>
                    <span class="tip-stats-teaser">{{ constant('App\\Enum\\BoostType::LOCKED_AFTER_MATCH_CTA') }}</span>
                </span>
            </span>
            {{ ghost }}
        </div>
    {% endif %}
{% endif %}
