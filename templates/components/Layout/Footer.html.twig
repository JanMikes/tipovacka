{#
  Site footer. variant:
   - marketing : public pages — brand + one row of links (item 17: was a four-column
                 grid; Funkce / Ceník / Pro firmy / Časté otázky are no longer linked,
                 the pages themselves stay reachable by URL)
   - app       : single-row mini footer (authenticated pages), the house precedent for
                 „really simple" that the marketing one now follows
#}
{% props variant = 'app' %}

{% if variant == 'marketing' %}
    <footer class="wtfoot">
        <div class="mx-auto w-full max-w-[80rem] px-6 py-10">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
                {# No brand-mark coin: `.brand-mark` is styled only inside `.wtnav`, so down
                   here it always rendered as a stray „W" next to the wordmark. #}
                <a href="{{ path('app_home') }}" class="text-lg font-black tracking-tight text-white">{{ brand_name }}</a>
                <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
                    <a href="{{ path('competitions_list') }}" class="text-white/70 transition-colors hover:text-white">Soutěže</a>
                    {% if not app.user %}
                        <a href="{{ path('app_login') }}" class="text-white/70 transition-colors hover:text-white">Přihlášení</a>
                        <a href="{{ path('app_register') }}" class="text-white/70 transition-colors hover:text-white">Registrace</a>
                    {% else %}
                        <a href="{{ path('dashboard') }}" class="text-white/70 transition-colors hover:text-white">Nástěnka</a>
                        <a href="{{ path('profile_edit') }}" class="text-white/70 transition-colors hover:text-white">Profil</a>
                    {% endif %}
                    <a href="{{ path('app_privacy') }}" class="text-white/70 transition-colors hover:text-white">Ochrana soukromí</a>
                </nav>
            </div>
            <div class="mt-8 flex flex-col gap-1 border-t border-white/5 pt-6 text-xs text-white/40 sm:flex-row sm:justify-between">
                <span>© {{ "now"|date("Y") }} {{ brand_name }}. Vše hraje, nic se nesází.</span>
                <span>Vyrobeno ve Frýdku-Místku.</span>
            </div>
        </div>
    </footer>
{% else %}
    <footer class="app-foot">
        <div class="mx-auto flex w-full max-w-[80rem] flex-col gap-2 px-4 py-8 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
            <span>© {{ "now"|date("Y") }} {{ brand_name }} · Tipuj s kámošema</span>
            <span class="flex gap-4">
                <a href="{{ path('app_privacy') }}" class="transition-colors hover:text-white">Ochrana soukromí</a>
            </span>
        </div>
    </footer>
{% endif %}
