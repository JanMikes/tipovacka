{# Compact read-only list of scoring rules for a competition.
   Usage: {{ include('_partials/competition_rules.html.twig', { items: rule_items }) }}
   `items` is a list of App\Query\GetCompetitionRuleConfiguration\RuleConfigurationItem.

   Optional `bare` (default false, item 26): render only the list, without the
   card chrome and the „Pravidla bodování" heading — for a caller that already
   draws its own container and title, i.e. the „Pravidla" modal on competition
   detail. In bare mode an empty rule set says so instead of rendering nothing:
   a dialog the viewer opened on purpose must never come up blank. #}
{% set bare = bare|default(false) %}
{% set enabledItems = items|filter(item => item.enabled) %}
{% set pad = bare ? 'px-4' : 'px-6' %}
{% set rows %}
    <ul class="divide-y divide-white/[0.06]{{ bare ? ' overflow-hidden rounded-xl border border-white/10 bg-inset' : '' }}">
        {% for item in enabledItems %}
            <li class="flex items-center justify-between gap-3 {{ pad }} py-3">
                <span class="text-sm font-medium text-white/80">{{ item.label }}</span>
                <span class="shrink-0 rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-sm font-semibold tabular-nums text-white">
                    {{ item.points }} b.
                </span>
            </li>
        {% endfor %}
    </ul>
{% endset %}

{% if bare %}
    {% if enabledItems|length > 0 %}
        {{ rows }}
    {% else %}
        <p class="rounded-xl border border-white/10 bg-inset px-4 py-3 text-sm text-white/55">
            Pro tuhle soutěž zatím nejsou nastavená žádná bodovací pravidla.
        </p>
    {% endif %}
{% elseif enabledItems|length > 0 %}
    <section class="card-glass overflow-hidden">
        <header class="flex items-center gap-2.5 border-b border-white/10 px-6 py-4">
            <twig:ux:icon name="lucide:activity" class="h-5 w-5 text-accent-400" />
            <h2 class="text-lg font-semibold text-white">Pravidla bodování</h2>
        </header>
        {{ rows }}
    </section>
{% endif %}
