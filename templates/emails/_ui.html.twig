{#
    Structural pieces of a mail that are more than one styled tag. Text styles live in the
    `st` map of emails/layout.html.twig; these macros carry their own, because a Twig macro
    cannot see the calling template's variables.
#}

{#
    The call to action. A padded <a> inside a coloured <td> (Cerberus „button-td"): the
    whole pill is clickable everywhere, and classic Outlook — which ignores padding on
    inline elements — still gets a correctly sized button from the cell. No VML: all it
    would buy is rounded corners in Outlook.
#}
{% macro button(label, url) %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" class="btn-table" style="margin:8px 0 24px;">
        <tr>
            <td class="btn-td" align="center" style="border-radius:10px;background-color:#2a6e9e;">
                <a class="btn-a" href="{{ url }}" style="display:block;padding:14px 30px;border-radius:10px;background-color:#2a6e9e;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:20px;font-weight:700;color:#ffffff;text-align:center;text-decoration:none;">{{ label }}</a>
            </td>
        </tr>
    </table>
{% endmacro %}

{# „Tlačítko nefunguje?" — the plain URL, for clients that strip or break the button. #}
{% macro linkFallback(url) %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:8px 0 0;">
        <tr>
            <td class="row" style="padding:18px 0 0;border-top:1px solid #dbe3ef;">
                <p class="muted" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#56658a;">
                    Tlačítko nefunguje? Zkopírujte do prohlížeče tento odkaz:<br>
                    <a class="link" href="{{ url }}" style="color:#2a6e9e;text-decoration:underline;word-break:break-all;">{{ url }}</a>
                </p>
            </td>
        </tr>
    </table>
{% endmacro %}
