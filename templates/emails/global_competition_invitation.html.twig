{#
    Pozvánka do GLOBÁLNÍ soutěže. Proti `competition_invitation.html.twig` má dva rozdíly,
    a oba jsou věcné, ne kosmetické: neexistuje žádná expirace (odkaz je veřejná stránka
    soutěže, ne token) a je v ní napsané vstupné — kdo klikne, má vědět, co ho to bude stát,
    dřív než si kvůli tomu založí účet.
#}
{% extends 'emails/layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Pozvánka do soutěže {{ competitionName }}{% endblock %}
{% block preheader %}{{ inviterNickname }} vás zve tipovat {{ matchSourceName }}. {{ entryFeeCredits > 0 ? 'Vstupné ' ~ (entryFeeCredits|credits) ~ '.' : 'Připojení je zdarma.' }}{% endblock %}

{% block content %}
    <p class="eyebrow" style="{{ st.eyebrow }}">Pozvánka</p>
    <h1 class="h1" style="{{ st.h1 }}">{{ inviterNickname }} vás zve do soutěže</h1>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="panel" style="{{ st.panel }}margin:4px 0 20px;">
        <tr>
            <td class="cell" style="{{ st.panelCell }}">
                <span class="h2" style="{{ st.h2 }}display:block;">{{ competitionName }}</span>
                <span class="detail" style="{{ st.detail }}">Zápasy: {{ matchSourceName }}</span>
            </td>
        </tr>
        <tr>
            <td class="cell row" style="{{ st.rowCell }}">
                {% if entryFeeCredits > 0 %}
                    Vstupné <strong class="strong" style="{{ st.strong }}">{{ entryFeeCredits|credits }}</strong><br>
                    <span class="detail" style="{{ st.detail }}">Odečteme je z vašeho kreditu ve chvíli, kdy se připojíte.</span>
                {% else %}
                    <strong class="strong" style="{{ st.strong }}">Připojení je zdarma.</strong>
                {% endif %}
            </td>
        </tr>
    </table>

    <p class="p" style="{{ st.p }}">
        Tipujete výsledky, sbíráte body a v žebříčku vidíte, jak si stojíte proti ostatním. Vše hraje, nic se nesází.
    </p>

    {{ ui.button('Prohlédnout soutěž', invitationUrl) }}

    <p class="muted" style="{{ st.muted }}">Nečekali jste tuhle pozvánku? E-mail klidně ignorujte.</p>

    {{ ui.linkFallback(invitationUrl) }}
{% endblock %}

{% block footer_reason %}
    <p class="footer" style="{{ st.footer }}">Tento e-mail jste dostali, protože vás hráč {{ inviterNickname }} pozval do soutěže.</p>
{% endblock %}
