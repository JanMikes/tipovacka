{% extends 'emails/layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Nastavte si nové heslo{% endblock %}
{% block preheader %}Odkaz pro nové heslo k účtu {{ userEmail }}. Platí 1 hodinu.{% endblock %}

{% block content %}
    <p class="eyebrow" style="{{ st.eyebrow }}">Zabezpečení účtu</p>
    <h1 class="h1" style="{{ st.h1 }}">Nastavte si nové heslo</h1>
    <p class="p" style="{{ st.p }}">
        Přišla nám žádost o obnovení hesla k účtu <strong class="strong" style="{{ st.strong }}">{{ userEmail }}</strong>. Nové heslo si nastavíte tlačítkem níže.
    </p>

    {{ ui.button('Nastavit nové heslo', resetUrl) }}

    <p class="muted" style="{{ st.muted }}">
        Odkaz platí 1 hodinu. Pokud jste o obnovení nežádali, nic se neděje — e-mail ignorujte a heslo zůstane stejné.
    </p>

    {{ ui.linkFallback(resetUrl) }}
{% endblock %}
