{% extends 'emails/layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Vítejte ve {{ brand_name }}{% endblock %}
{% block preheader %}Účet je ověřený. Tři kroky a tipujete s partou.{% endblock %}

{% block content %}
    <p class="eyebrow" style="{{ st.eyebrow }}">Účet je připravený</p>
    <h1 class="h1" style="{{ st.h1 }}">Vítejte ve hře, {{ nickname }}!</h1>
    <p class="p" style="{{ st.p }}">
        {{ brand_name }} je tipovačka pro partu: tipujete výsledky zápasů, sbíráte body a sledujete, kdo z vás má na sport opravdu čich.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="panel" style="{{ st.panel }}margin:4px 0 20px;">
        {% for step in [
            { title: 'Založte soutěž, nebo se připojte', detail: 'Vlastní soutěž pro kamarády, nebo veřejná, kde může hrát každý.' },
            { title: 'Natipujte zápasy', detail: 'Stačí to stihnout do uzávěrky. Když vám tip chybí, připomeneme se.' },
            { title: 'Sledujte žebříček', detail: 'Body přibývají, jakmile je zápas vyhodnocený.' },
        ] %}
            <tr>
                <td class="cell {{ loop.first ? '' : 'row' }}" width="34" valign="top" style="{{ loop.first ? st.rowCellFirst : st.rowCell }}padding-right:0;">
                    <span class="strong" style="{{ st.strong }}">{{ loop.index }}.</span>
                </td>
                <td class="cell {{ loop.first ? '' : 'row' }}" valign="top" style="{{ loop.first ? st.rowCellFirst : st.rowCell }}padding-left:4px;">
                    <span class="strong" style="{{ st.strong }}">{{ step.title }}</span><br>
                    <span class="detail" style="{{ st.detail }}">{{ step.detail }}</span>
                </td>
            </tr>
        {% endfor %}
    </table>

    {{ ui.button('Začít tipovat', loginUrl) }}

    <p class="muted" style="{{ st.muted }}margin-bottom:0;">Hodně přesných tipů!</p>
{% endblock %}
