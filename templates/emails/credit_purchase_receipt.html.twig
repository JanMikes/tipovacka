{% extends 'emails/layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Kredity připsány{% endblock %}
{% block preheader %}Připsali jsme vám {{ credits|credits }}. Zůstatek: {{ balance|credits }}.{% endblock %}

{% block content %}
    <p class="eyebrow" style="{{ st.eyebrow }}">Platba přijata</p>
    <h1 class="h1" style="{{ st.h1 }}">Kredity jsou na účtu, {{ nickname }}</h1>
    <p class="p" style="{{ st.p }}">Děkujeme za nákup. Tady je, co se změnilo ve vaší peněžence:</p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="panel" style="{{ st.panel }}margin:4px 0 20px;">
        <tr>
            <td class="cell" style="{{ st.rowCellFirst }}">Připsáno</td>
            <td class="cell" align="right" style="{{ st.rowCellFirst }}text-align:right;">
                <strong class="strong" style="{{ st.strong }}">+{{ credits|credits }}</strong>
            </td>
        </tr>
        <tr>
            <td class="cell row" style="{{ st.rowCell }}">Zůstatek</td>
            <td class="cell row" align="right" style="{{ st.rowCell }}text-align:right;">
                <strong class="strong" style="{{ st.strong }}">{{ balance|credits }}</strong>
            </td>
        </tr>
    </table>

    {{ ui.button('Zobrazit kredity', creditsUrl) }}

    {% if invoiceUrl %}
        <p class="muted" style="{{ st.muted }}margin-bottom:0;">
            Fakturu si můžete <a class="link" href="{{ invoiceUrl }}" style="{{ st.link }}">stáhnout zde</a>.
        </p>
    {% endif %}
{% endblock %}
