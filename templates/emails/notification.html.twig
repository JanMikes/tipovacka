{#
    ONE notification, mailed on its own — a guess reminder for an „průběžně" player, a
    money alert, a single piece of news. Sent only by NotificationMailer, which supplies
    `unsubscribeUrl` (switches off THIS type, no login) and `settingsUrl`.

    `body` is plain text with line breaks; `items` is an optional list under it (the
    reminder lists one soutěž per row). `url` and item urls are host-relative.
#}
{% extends 'emails/layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}{{ title }}{% endblock %}
{% block preheader %}{{ body|split("\n")|first }}{% endblock %}

{% block content %}
    <p class="eyebrow" style="{{ st.eyebrow }}">{{ type.label }}</p>
    <h1 class="h1" style="{{ st.h1 }}">{{ title }}</h1>
    <p class="p" style="{{ st.p }}">{{ body|nl2br }}</p>

    {% if items is not empty %}
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="panel" style="{{ st.panel }}margin:4px 0 20px;">
            {% for item in items %}
                <tr>
                    <td class="cell {{ loop.first ? '' : 'row' }}" style="{{ loop.first ? st.rowCellFirst : st.rowCell }}">
                        {% if item.url %}
                            <a class="strong" href="{{ absolute_url(item.url) }}" style="{{ st.strong }}text-decoration:none;">{{ item.title }}</a>
                        {% else %}
                            <span class="strong" style="{{ st.strong }}">{{ item.title }}</span>
                        {% endif %}
                        {% if item.detail %}
                            <br><span class="detail" style="{{ st.detail }}">{{ item.detail }}</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {% if url is not empty %}
        {{ ui.button(type.actionLabel, absolute_url(url)) }}
    {% endif %}
{% endblock %}

{% block footer_reason %}
    <p class="footer" style="{{ st.footer }}">
        Tento e-mail vám chodí, protože máte zapnuté oznámení „{{ type.label }}“.<br>
        <a class="footer-link" href="{{ unsubscribeUrl }}" style="{{ st.footerLink }}">Odhlásit tento typ</a>
        &nbsp;&middot;&nbsp;
        <a class="footer-link" href="{{ settingsUrl }}" style="{{ st.footerLink }}">Změnit, jak často píšeme</a>
    </p>
{% endblock %}
