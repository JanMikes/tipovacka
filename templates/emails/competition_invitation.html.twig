{% extends 'emails/layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Pozvánka do soutěže {{ competitionName }}{% endblock %}
{% block preheader %}{{ inviterNickname }} vás zve tipovat {{ matchSourceName }}. Pozvánka platí do {{ expiresAt|date('j. n.') }}.{% endblock %}

{% block content %}
    <p class="eyebrow" style="{{ st.eyebrow }}">Pozvánka</p>
    <h1 class="h1" style="{{ st.h1 }}">{{ inviterNickname }} vás zve do soutěže</h1>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="panel" style="{{ st.panel }}margin:4px 0 20px;">
        <tr>
            <td class="cell" style="{{ st.panelCell }}">
                <span class="h2" style="{{ st.h2 }}display:block;">{{ competitionName }}</span>
                <span class="detail" style="{{ st.detail }}">Zápasy: {{ matchSourceName }}</span>
            </td>
        </tr>
    </table>

    <p class="p" style="{{ st.p }}">
        Tipujete výsledky, sbíráte body a v žebříčku vidíte, jak si stojíte proti ostatním. Vše hraje, nic se nesází.
    </p>

    {{ ui.button('Přijmout pozvánku', invitationUrl) }}

    <p class="muted" style="{{ st.muted }}">
        Pozvánka platí do {{ expiresAt|date('j. n. Y H:i') }}. Nečekali jste ji? E-mail klidně ignorujte.
    </p>

    {{ ui.linkFallback(invitationUrl) }}
{% endblock %}

{% block footer_reason %}
    <p class="footer" style="{{ st.footer }}">Tento e-mail jste dostali, protože vás hráč {{ inviterNickname }} pozval do své soutěže.</p>
{% endblock %}
