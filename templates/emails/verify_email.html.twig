{% extends 'emails/layout.html.twig' %}
{% import 'emails/_ui.html.twig' as ui %}

{% block title %}Potvrďte svůj e-mail{% endblock %}
{% block preheader %}Jedno kliknutí a můžete tipovat. Odkaz platí do {{ expiresAt|date('j. n. H:i') }}.{% endblock %}

{% block content %}
    <p class="eyebrow" style="{{ st.eyebrow }}">Registrace</p>
    <h1 class="h1" style="{{ st.h1 }}">Ještě jedno kliknutí, {{ nickname }}</h1>
    <p class="p" style="{{ st.p }}">
        Díky za registraci ve {{ brand_name }}. Potvrďte prosím, že je tahle adresa vaše — pak už vás od tipování nic nedělí.
    </p>

    {{ ui.button('Potvrdit e-mail', verificationUrl) }}

    <p class="muted" style="{{ st.muted }}">
        Odkaz platí do {{ expiresAt|date('j. n. Y H:i') }}. Pokud jste se neregistrovali vy, e-mail klidně ignorujte.
    </p>

    {{ ui.linkFallback(verificationUrl) }}
{% endblock %}
