{% extends 'auth/_layout.html.twig' %}

{% block title %}E-mail odeslán — {{ brand_name }}{% endblock %}

{% block auth_panel_tagline %}Zkontrolujte schránku, odkaz dorazil do pár vteřin.{% endblock %}

{% block auth_card %}
<div class="card-glass p-8 text-center sm:p-10">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-win/30 bg-win/10 text-win">
        <twig:ux:icon name="lucide:circle-check" class="h-7 w-7" />
    </div>

    <span class="eyebrow mt-6 block">Odkaz odeslán</span>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-white">Zkontrolujte schránku</h1>
    <p class="mt-3 text-sm text-white/60">
        Pokud u nás máte zaregistrovaný účet s tímto e-mailem, odeslali jsme vám odkaz pro obnovení hesla. Odkaz je platný 1 hodinu.
    </p>

    {# Nothing arrived is the one question this page gets. The bundle sends at most one
       reset mail per hour per account and a repeat request is silently dropped, so
       „request again" only helps once that hour has passed — say so. #}
    <div class="mt-6 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-left text-sm text-white/60">
        <p class="font-semibold text-white/80">E-mail nedorazil?</p>
        <ul class="mt-1.5 list-disc space-y-1 pl-5">
            <li>Podívejte se do složky Hromadné, Spam nebo Promoakce.</li>
            <li>Zkontrolujte, že jste zadali stejný e-mail, se kterým jste se registrovali.</li>
            <li>Nový odkaz vám můžeme poslat nejdříve za hodinu — do té doby platí ten předchozí.
                <a href="{{ path('app_forgot_password_request') }}" class="font-semibold text-accent-300 hover:text-white">Zadat e-mail znovu</a></li>
        </ul>
    </div>

    <a href="{{ path('app_login') }}" class="btn btn-link mt-8 inline-flex items-center gap-1.5 text-sm">
        <twig:ux:icon name="lucide:arrow-left" class="h-4 w-4" />
        Zpět na přihlášení
    </a>
</div>
{% endblock %}
