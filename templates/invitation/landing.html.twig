{% extends 'auth/_layout.html.twig' %}

{% set competition_name = context ? context.competitionName : null %}
{# Every status page offers a way forward — a dead end with nothing to click is where
   a new visitor gives up. Signed in → their Nástěnka; not yet → the homepage. #}
{% set way_out_url = app.user ? path('dashboard') : path('app_home') %}
{% set way_out_label = app.user ? 'Přejít na Nástěnku' : 'Na úvodní stránku' %}

{% block title %}{{ competition_name ? 'Připojení do soutěže ' ~ competition_name : 'Pozvánka' }} — {{ brand_name }}{% endblock %}

{% block auth_card %}
<div class="card-glass p-8 sm:p-10">

    {% if step == 'invalid' %}
        <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-loss/30 bg-loss/10 text-loss">
                <twig:ux:icon name="lucide:circle-x" class="h-8 w-8" />
            </div>
            <p class="eyebrow mt-6">Pozvánka</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Pozvánka nenalezena</h2>
            <p class="mt-3 text-white/60">Odkaz je neplatný nebo už neexistuje. Zkontrolujte, že jste ho otevřeli celý (dlouhé odkazy se v některých aplikacích zalomí), nebo požádejte organizátora o nový.</p>
            <a href="{{ path('competition_join_by_pin') }}" class="btn btn-primary mt-8 w-full">
                <twig:ux:icon name="lucide:key-round" class="h-4 w-4" />
                Mám PIN soutěže
            </a>
            {% if not app.user %}
                <a href="{{ path('app_login') }}" class="btn btn-link mt-4 inline-flex items-center gap-1.5 text-sm">
                    <twig:ux:icon name="lucide:log-in" class="h-4 w-4" />
                    Přihlásit se
                </a>
            {% endif %}
        </div>

    {% elseif step == 'expired' %}
        <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-draw/30 bg-draw/10 text-draw">
                <twig:ux:icon name="lucide:clock" class="h-8 w-8" />
            </div>
            <p class="eyebrow mt-6">Pozvánka</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Pozvánka vypršela</h2>
            <p class="mt-3 text-white/60">Platnost pozvánky skončila. Požádejte toho, kdo vás pozval, o novou — nebo o PIN soutěže.</p>
            <a href="{{ way_out_url }}" class="btn btn-ghost mt-8 w-full">{{ way_out_label }}</a>
        </div>

    {% elseif step == 'revoked' %}
        <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-loss/30 bg-loss/10 text-loss">
                <twig:ux:icon name="lucide:circle-x" class="h-8 w-8" />
            </div>
            <p class="eyebrow mt-6">Pozvánka</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Pozvánka byla zrušena</h2>
            <p class="mt-3 text-white/60">Organizátor tuto pozvánku zrušil, takže už neplatí. Pokud se chcete připojit, požádejte ho o novou.</p>
            <a href="{{ way_out_url }}" class="btn btn-ghost mt-8 w-full">{{ way_out_label }}</a>
        </div>

    {% elseif step == 'accepted' %}
        <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-win/30 bg-win/10 text-win">
                <twig:ux:icon name="lucide:circle-check" class="h-8 w-8" />
            </div>
            <p class="eyebrow mt-6">Pozvánka</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Pozvánka už byla přijata</h2>
            {% if app.user %}
                <p class="mt-3 text-white/60">Pokud jste ji přijali vy, soutěž najdete na Nástěnce.</p>
                <a href="{{ path('dashboard') }}" class="btn btn-primary mt-8 w-full">
                    <twig:ux:icon name="lucide:arrow-right" class="h-4 w-4" />
                    Přejít na Nástěnku
                </a>
            {% else %}
                <p class="mt-3 text-white/60">Přihlaste se a pokračujte v tipování.</p>
                <a href="{{ path('app_login') }}" class="btn btn-primary mt-8 w-full">
                    <twig:ux:icon name="lucide:log-in" class="h-4 w-4" />
                    Přihlásit se
                </a>
            {% endif %}
        </div>

    {% elseif step == 'match_source_completed' %}
        <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-white/70">
                <twig:ux:icon name="lucide:lock" class="h-8 w-8" />
            </div>
            <p class="eyebrow mt-6">Pozvánka</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Soutěž už skončila</h2>
            <p class="mt-3 text-white/60">Všechny zápasy soutěže{% if competition_name %} <strong class="font-semibold text-white">{{ competition_name }}</strong>{% endif %} už jsou odehrané, takže se do ní připojit nejde. Zeptejte se organizátora, jestli chystá další.</p>
            <a href="{{ way_out_url }}" class="btn btn-ghost mt-8 w-full">{{ way_out_label }}</a>
        </div>

    {% elseif step == 'email_mismatch' %}
        <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-draw/30 bg-draw/10 text-draw">
                <twig:ux:icon name="lucide:user-x" class="h-8 w-8" />
            </div>
            <p class="eyebrow mt-6">Pozvánka</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">Pozvánka je pro jiný e-mail</h2>
            <p class="mt-3 text-white/60">
                Teď jste přihlášeni jako <strong class="font-semibold text-white">{{ current_user_email }}</strong>, ale tato pozvánka patří adrese <strong class="font-semibold text-white">{{ context.presetEmail }}</strong>.
            </p>
            <form method="post" action="{{ path('app_logout') }}" class="mt-8">
                <button type="submit" class="btn btn-primary w-full">
                    <twig:ux:icon name="lucide:log-out" class="h-4 w-4" />
                    Odhlásit se a pokračovat
                </button>
            </form>
            <p class="mt-4 text-sm text-white/50">Po odhlášení se otevře přihlášení — přihlaste se k adrese z pozvánky, nebo si k ní založte účet.</p>
        </div>

    {% else %}
        {# Active state — anonymous: name the soutěž they are about to join, then the unified live form #}
        <div class="mb-6 flex items-start gap-3 rounded-xl border border-accent-500/40 bg-accent-500/10 p-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-accent-500/40 bg-white/5 text-accent-300">
                <twig:ux:icon name="lucide:users" class="h-5 w-5" />
            </span>
            <p class="text-sm leading-relaxed text-white/70">
                Chystáte se připojit do soutěže <strong class="font-semibold text-white">{{ context.competitionName }}</strong>.
            </p>
        </div>

        {#
            Vstupné se říká PŘED registrací, ne až za ní. Nenulové je jen u globální
            soutěže (do soukromé se chodí zdarma), takže tenhle blok se jinde nevykreslí.
            Kdo si kvůli soutěži zakládá účet, má vědět, co ho čeká, dokud ještě může couvnout.
        #}
        {% if context.entryFeeCredits > 0 %}
            <div class="mb-6 flex items-start gap-3 rounded-xl border border-draw/30 bg-draw/10 p-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-draw/30 bg-white/5 text-draw">
                    <twig:ux:icon name="lucide:coins" class="h-5 w-5" />
                </span>
                <p class="text-sm leading-relaxed text-white/70">
                    Vstupné je <strong class="font-semibold text-white">{{ context.entryFeeCredits|credits }}</strong> — odečteme je z vašeho kreditu ve chvíli, kdy se připojíte. Když vám kredity nestačí, nabídneme dobití.
                </p>
            </div>
        {% endif %}

        <twig:Auth:InvitationForm kind="{{ context.kind.value }}" token="{{ context.token }}" />

        <p class="mt-6 text-center text-sm text-white/50">
            <a href="{{ path('app_login') }}" class="font-semibold text-accent-300 transition-colors hover:text-accent-200">Mám už účet a chci se přihlásit jinak</a>
        </p>
    {% endif %}
</div>
{% endblock %}
